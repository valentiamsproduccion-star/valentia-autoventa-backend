# Copia este archivo a .env y rellena los valores reales.
# Nada de esto debe subirse nunca a un repositorio público.

# Puerto en el que escucha el servidor (el hosting que elijas puede fijarlo por su cuenta)
PORT=3000

# URL pública base del backend, la que verá el navegador del cliente
# (para construir los enlaces de vista previa, checkout y el enlace mágico)
PUBLIC_BASE_URL=http://localhost:3000

# ── Anthropic (redacción de contenido con IA) ──────────────────────────────
# Crea una clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── OpenAI (logo con IA, ver formulario de alta "Logo y favicon") ──────────
# Genera las 3 opciones de logo (y sus formatos) ANTES de la compra.
# Crea una clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Modo prueba: true = no llama a OpenAI, devuelve un PNG de relleno gratis --
# úsalo para probar el flujo del alta sin gastar saldo real. NUNCA en producción.
OPENAI_IMAGES_MODO_PRUEBA=false

# ── Stripe (pagos) ──────────────────────────────────────────────────────────
# Modo test para probar sin dinero real: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Lo genera Stripe al crear el endpoint de webhook (ver README)
STRIPE_WEBHOOK_SECRET=
# IDs de Price creados en el Dashboard de Stripe (Productos > Añadir producto)
STRIPE_PRICE_INICIAL=
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_SUPLEMENTO_PAGINA=
# Dominio propio (+2€/mes, cuota recurrente) -- se cobra cuando el cliente
# elige comprar un dominio en el alta, sección "Tu dominio". Cubre con
# margen el coste real de registro/renovación anual (ver services/
# openprovider.js, ~8-15€/año según el TLD).
STRIPE_PRICE_DOMINIO_PROPIO=
# Logo diseñado por IA (+15€, pago único) -- casilla "Quiero que la IA me
# diseñe un logo" en el alta cuando el cliente no tiene logo propio.
STRIPE_PRICE_LOGO_IA=

# ── Supabase (base de datos, ver README "Base de datos (Supabase)") ────────
# Project URL, en Project Settings > API
SUPABASE_URL=
# service_role secret (NO la anon/public), en Project Settings > API
SUPABASE_SERVICE_KEY=
# Bucket PÚBLICO de Supabase Storage donde se guardan los logos/favicons que
# suben los clientes en el alta (Storage > New bucket > marcar "Public").
# Si no se pone, se usa "logos" por defecto.
SUPABASE_STORAGE_BUCKET=logos
# Bucket PÚBLICO aparte para las fotos del negocio (hero, foto secundaria,
# galería, y fotos por tarjeta de equipo/productos/proyectos/actividades/
# alojamientos -- ver README "Fotos del negocio"). Si no se pone, se usa
# "fotos" por defecto.
SUPABASE_FOTOS_BUCKET=fotos

# ── Resend (envío del enlace mágico por email, ver README "Email (Resend)") ─
# Crea una cuenta gratuita en https://resend.com y genera una API key
RESEND_API_KEY=
# Remitente. Para usar un dominio propio (recomendado) hay que verificarlo
# antes en Resend; mientras tanto sirve el remitente de pruebas de Resend.
EMAIL_FROM=Valentia <onboarding@resend.dev>
# Email del equipo al que avisar cuando un cliente paga el logo con IA (+15€),
# para diseñarlo y subirlo manualmente. Si se deja vacío, solo se avisa por
# log del servidor (ver services/email.js, sendLogoIaSolicitadoEmail).
ADMIN_EMAIL=

# ── Openprovider (compra de dominio propio, ver README "Dominio propio") ───
# Sin API key fija: se hace login con usuario/contraseña, igual que en el
# panel (cp.openprovider.eu). Para probar SIN gastar nada, usa las
# credenciales de la cuenta de Sandbox (cp.sandbox.openprovider.nl, alta
# aparte y gratuita) y pon OPENPROVIDER_API_HOST=api.sandbox.openprovider.nl.
# Si se dejan vacías, la compra de dominio queda desactivada sin más --
# el resto del alta sigue funcionando igual (ver services/openprovider.js).
OPENPROVIDER_USER=
OPENPROVIDER_PASSWORD=
# api.openprovider.eu (real) o api.sandbox.openprovider.nl (pruebas, gratis)
OPENPROVIDER_API_HOST=api.openprovider.eu

# ── Render (conectar el dominio comprado a este mismo servicio) ────────────
# API key: Render, Account Settings > API Keys.
RENDER_API_KEY=
# Empieza por "srv-", está en la URL del dashboard de este servicio.
RENDER_SERVICE_ID=
# IP fija que documenta Render para dominios raíz -- normalmente no hace
# falta tocar esto (ver services/renderDominios.js).
RENDER_A_RECORD_IP=216.24.57.1
# El subdominio *.onrender.com de este servicio, para el CNAME de "www".
PUBLIC_BASE_URL_ONRENDER=valentia-autoventa-backend.onrender.com
