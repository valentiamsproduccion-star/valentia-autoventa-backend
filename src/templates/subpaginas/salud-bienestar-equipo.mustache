<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0F2A3D">
<title>{{nombre_negocio}} — Equipo</title>
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<meta name="description" content="Conoce al equipo de {{nombre_negocio}}.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,560;0,9..144,700;0,9..144,900;1,9..144,500&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · SALUD Y BIENESTAR
   Variante: Clínica (fisioterapia / psicología)
   Paleta: Azul clínico + menta — confianza y frescura
   ═══════════════════════════════════════ */
:root{
  --ink:        #0F2A3D;
  --ink-mid:    #1B3E52;
  --paper:      #F4F9F8;
  --white-pure: #ffffff;
  --accent:     #2FA8A0;
  --accent-mid: #1F7A73;
  --accent-hover: #17615B;
  --accent-dim: rgba(47,168,160,.12);
  --text-body:  rgba(15,42,61,.78);
  --text-muted: rgba(15,42,61,.56);
  --border:     rgba(15,42,61,.10);
  --border-acc: rgba(47,168,160,.28);
  --serif: 'Fraunces', Georgia, serif;
  --sans:  'Instrument Sans', 'Helvetica Neue', Arial, sans-serif;
  --radius-sm: 6px;
  --radius-md: 10px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);color:var(--ink);line-height:1.6;background:var(--paper)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--serif);color:var(--ink);line-height:1.2;font-weight:540;letter-spacing:-.01em}

.btn{display:inline-block;font-family:var(--sans);font-weight:700;font-size:.8rem;letter-spacing:.08em;padding:.9rem 1.8rem;border-radius:100px;cursor:pointer;transition:.25s ease;border:1px solid transparent}
.btn-primary{background:var(--accent-mid);color:#fff;border-color:var(--accent-mid)}
.btn-primary:hover{background:var(--accent-hover);border-color:var(--accent-hover)}
.btn-outline{background:transparent;color:var(--ink);border-color:var(--border)}
.btn-outline:hover{border-color:var(--border-acc);color:var(--accent-mid)}

.eyebrow{display:flex;align-items:center;gap:.85rem;margin-bottom:1.1rem;font-family:var(--sans);font-size:.74rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-mid)}
.eyebrow::before{content:'';width:1.7rem;height:2px;background:var(--accent);flex:none}

.tag{display:inline-block;font-size:10.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--accent-mid);background:var(--accent-dim);padding:4px 10px;border-radius:100px;margin-bottom:8px}

/* HEADER */
header{position:sticky;top:0;z-index:50;background:rgba(244,249,248,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--border)}
.nav{display:flex;align-items:center;justify-content:space-between;height:76px;gap:16px}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-weight:600;font-size:19px;color:var(--ink);flex:none}
.logo .mark{width:34px;height:34px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:700;font-size:15px}
.logo img{height:36px;width:auto;display:block}
.nav-links{display:flex;gap:26px;align-items:center}
.nav-links a:not(.btn){color:var(--text-body);font-weight:600;font-size:14px}
.nav-links a:not(.btn):hover{color:var(--accent-mid)}
.nav .btn{padding:10px 18px;font-size:12.5px}
@media(max-width:760px){.nav-links a:not(.btn){display:none}}
@media(max-width:480px){.nav .btn{display:none}.logo{font-size:17px}}

/* HERO */
.hero{padding:clamp(3rem,4.5vw,5.5rem) 0 clamp(3.5rem,5vw,5.5rem)}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:3rem;align-items:center}
@media(max-width:860px){.hero-grid{grid-template-columns:1fr}}
.hero-title{font-size:clamp(2rem,4vw,3rem);max-width:14em}
.hero p.sub{font-size:clamp(15.5px,1.7vw,18px);color:var(--text-body);max-width:36em;margin:18px 0 28px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
.hero-photo{object-fit:cover;aspect-ratio:4/3;background:var(--accent-dim);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;color:var(--accent-mid);font-family:var(--serif);font-size:14px;text-align:center;padding:20px}

.trust{display:flex;flex-wrap:wrap;gap:16px 30px;margin-top:28px;color:var(--text-body);font-weight:600;font-size:13.5px}
.trust span{display:flex;align-items:center;gap:8px}
.trust span::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex:none}

/* SECTIONS */
section.blk{padding:5rem 0}
.h2{font-size:clamp(1.6rem,3vw,2.3rem);max-width:640px}
.lead{color:var(--text-body);font-size:16.5px;max-width:640px;margin-top:12px}
.alt{background:var(--white-pure);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}

/* TRATAMIENTOS */
.treats{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;margin-top:3rem}
@media(max-width:860px){.treats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.treats{grid-template-columns:1fr}}
.treat{background:var(--white-pure);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.8rem 1.6rem}
.treat .ic{width:44px;height:44px;border-radius:50%;background:var(--accent-dim);color:var(--accent-mid);display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:14px}
.treat h3{font-size:16.5px;margin-bottom:6px;font-weight:600}
.treat p{color:var(--text-body);font-size:13.8px}

/* EQUIPO */
.team{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;margin-top:3rem}
@media(max-width:760px){.team{grid-template-columns:1fr}}
.member{background:var(--paper);border:1px solid var(--border);border-radius:var(--radius-md);overflow:hidden}
.member .ph{object-fit:cover;aspect-ratio:4/5;background:var(--ink-mid);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.3);font-family:var(--serif);font-size:13px}
.member .info{padding:1.3rem 1.4rem}
.member h3{font-size:16px;font-weight:600}
.member .role{color:var(--accent-mid);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.05em;margin-top:2px}
.member .cred{color:var(--text-muted);font-size:13px;margin-top:8px}

/* GALERIA ANTES/DESPUES */
.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:3rem}
@media(max-width:760px){.gallery{grid-template-columns:repeat(2,1fr)}}
.gpair{border:1px solid var(--border);border-radius:var(--radius-md);overflow:hidden;background:var(--white-pure)}
.gpair .imgs{display:grid;grid-template-columns:1fr 1fr}
.gpair .imgs div{aspect-ratio:1/1;background:var(--ink-mid);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.3);font-size:11px}
.gpair .cap{padding:10px 12px;font-size:12px;color:var(--text-muted);text-align:center}

/* CITA / FORM */
.cita{background:var(--ink);color:#fff}
.cita .h2, .cita h2{color:#fff}
.cita .lead{color:rgba(255,255,255,.68)}
.cita .eyebrow{color:rgba(255,255,255,.55)}
.cita-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin-top:2.5rem;align-items:start}
@media(max-width:860px){.cita-grid{grid-template-columns:1fr}}
.cita-points{display:flex;flex-direction:column;gap:1.3rem}
.cpoint{display:flex;gap:14px}
.cpoint .ic{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.1);flex:none;display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}
.cpoint h4{font-size:15px;font-weight:600;color:#fff}
.cpoint p{font-size:13.5px;color:rgba(255,255,255,.62);margin-top:3px}
.cita-note{margin-top:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:var(--radius-sm);padding:14px 16px;font-size:12.5px;color:rgba(255,255,255,.65)}

.form-card{background:var(--white-pure);border-radius:var(--radius-md);padding:1.8rem}
.form-card label{font-weight:600;color:var(--ink);font-size:13.5px;display:block;margin-bottom:6px}
.field{margin-bottom:14px}
.field input,.field select,.field textarea{width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:14.5px;font-family:var(--sans);outline:none;background:var(--paper);color:var(--ink)}
.field textarea{resize:vertical;min-height:70px}
.consent{display:flex;gap:10px;align-items:flex-start;margin:14px 0;font-size:12px;color:var(--text-muted);line-height:1.5}
.consent input{margin-top:3px;flex:none}
.form-note{font-size:11.5px;color:var(--text-muted);margin-top:10px;line-height:1.5}

/* RESEÑAS */
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:1.3rem;margin-top:3rem}
@media(max-width:760px){.reviews{grid-template-columns:1fr}}
.review{background:var(--white-pure);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.6rem}
.review .stars{color:var(--accent);font-size:14px;margin-bottom:10px}
.review p{font-size:14.5px;color:var(--text-body);font-style:italic}
.review .who{margin-top:14px;font-weight:700;font-size:13px}

/* CONTACTO / MAPA */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;margin-top:2.5rem;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1.1rem}
.citem{display:flex;gap:14px;align-items:flex-start}
.citem .ic{width:36px;height:36px;border-radius:50%;background:var(--accent-dim);color:var(--accent-mid);display:flex;align-items:center;justify-content:center;flex:none;font-weight:700;font-size:14px}
.citem h4{font-size:14.5px;font-weight:600}
.citem p{font-size:13.5px;color:var(--text-muted)}
.map-embed{border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--border);aspect-ratio:4/3}
.map-embed iframe{width:100%;height:100%;border:0}

/* FOOTER */
footer{background:var(--ink);color:rgba(255,255,255,.55);padding:34px 0;font-size:13px}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:22px;flex-wrap:wrap}
.foot-links a:hover{color:#fff}
.legal-note{max-width:820px;margin:16px auto 0;text-align:center;font-size:11.5px;color:rgba(255,255,255,.4);line-height:1.6}

/* FAQ */
.faq{margin-top:2.5rem;max-width:820px}
.faq details{border-bottom:1px solid var(--border);padding:1.2rem 0}
.faq summary{font-family:var(--serif);font-size:17px;font-weight:560;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;color:var(--ink)}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';font-family:var(--sans);font-size:22px;color:var(--accent);flex:none;transition:.2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{color:var(--text-body);font-size:14.5px;margin-top:12px;max-width:70ch}

/* WHATSAPP FLOAT */
.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.25);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}

/* CTA FIJA MÓVIL */
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--border);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:12px}
@media(max-width:600px){.cta-bar{display:flex}}

.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--ink);color:#fff;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;border-radius:100px;opacity:.85;z-index:61;font-family:var(--sans)}
@media(max-width:600px){.tpl-badge{bottom:78px}}

.page-header{padding:clamp(2.6rem,4vw,3.6rem) 0;background:linear-gradient(180deg,var(--paper) 0%,#00000010 100%)}
.page-header h1{font-size:clamp(1.9rem,3.4vw,2.7rem);max-width:20em}
.page-header .lead{color:var(--text-body);font-size:16.5px;max-width:640px;margin-top:12px}
.nav-links a.current{color:var(--accent-mid,var(--accent))}
.cta-block{background:var(--ink);color:#fff;border-radius:var(--radius-md);padding:2.4rem;text-align:center;margin-top:3rem}
.cta-block h2{color:#fff;font-size:1.5rem}
.cta-block p{color:rgba(255,255,255,.68);margin:10px 0 20px;font-size:14.5px}
.cta-block .btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <a class="logo" href="index.html">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{^logo_url}}<span class="mark">{{inicial_negocio}}</span> {{nombre_negocio}}{{/logo_url}}</a>
    <nav class="nav-links">
      <a href="tratamientos.html">Tratamientos</a>
      <a href="equipo.html" class="current">Equipo</a>
      <a href="contacto.html">Contacto</a>
      <a href="contacto.html" class="btn btn-primary">Pedir cita</a>
    </nav>
  </div>
</header>

<section class="page-header">
  <div class="wrap">
    <div class="eyebrow">Equipo</div>
    <h1>Quién te va a atender.</h1>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="team">
      {{#equipo}}
      <div class="member">
        {{#foto_url}}<img class="ph" src="{{foto_url}}" alt="{{nombre}}">{{/foto_url}}{{^foto_url}}<div class="ph">Foto</div>{{/foto_url}}
        <div class="info"><h3>{{nombre}}</h3><div class="role">{{rol}}</div><p class="cred">{{credencial}}</p></div>
      </div>
      {{/equipo}}
    </div>

    <div class="cta-block">
      <h2>¿Quieres pedir cita?</h2>
      <p>Te asignamos al profesional adecuado para tu caso.</p>
      <div class="btns">
        <a href="contacto.html" class="btn btn-primary">Pedir cita</a>
        <a href="tel:{{telefono}}" class="btn btn-outline" style="border-color:rgba(255,255,255,.3);color:#fff">Llamar ahora</a>
      </div>
    </div>

  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Salud y bienestar</div>
      <div class="foot-links">
        <a href="aviso-legal.html">Aviso legal</a>
        <a href="privacidad.html">Política de privacidad</a>
        <a href="cookies.html">Cookies</a>
      </div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar">
  <a href="tel:{{telefono}}" class="btn btn-outline">Llamar</a>
  <a href="contacto.html" class="btn btn-primary">Pedir cita</a>
</div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Escribir por WhatsApp">
