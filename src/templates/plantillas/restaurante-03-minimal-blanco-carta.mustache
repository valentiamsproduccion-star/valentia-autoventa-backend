<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#FAFAFA">
<title>{{nombre_negocio}} — Hostelería</title>
<meta name="description" content="{{hero_subtitle}}">
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · HOSTELERÍA · Restaurante
   Diseño 3: Minimal blanco carta
   ═══════════════════════════════════════ */
:root{
  --accent:#2A6F5E; --accent-mid:#1E5347; --accent-dim:#DCEAE6;
  --ink:#1A1A1A; --ink-soft:#6E6E6E; --cream:#FAFAFA; --white-pure:#FFFFFF; --line:#E4E4E4;
  --serif:'DM Sans',sans-serif; --sans:'Inter',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);color:var(--ink);line-height:1.65;background:var(--cream)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:700}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
header{padding:26px 0;border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:var(--serif);font-weight:700;font-size:20px;letter-spacing:-.01em;display:flex;align-items:center;gap:9px}
.logo img{height:30px;width:auto;display:block}
.logo .mark{width:28px;height:28px;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}
nav ul{list-style:none;display:flex;gap:30px;font-size:13px}
nav ul a{color:var(--ink);text-decoration:none}
nav ul a:hover{color:var(--accent)}
.btn{display:inline-block;padding:12px 26px;font-size:13px;font-weight:600;text-decoration:none;border:none;cursor:pointer;text-align:center}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent-mid)}
.btn-ghost{color:var(--ink);border:1px solid var(--ink);background:transparent}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
@media(max-width:760px){nav ul{display:none}}

.hero{padding:70px 0 90px}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}
@media(max-width:860px){.hero-grid{grid-template-columns:1fr}}
.hero .eyebrow{display:inline-block;color:var(--accent);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}
.hero h1{font-size:42px;line-height:1.12;margin-bottom:18px;letter-spacing:-.02em}
.hero p{color:var(--ink-soft);font-size:15px;margin-bottom:26px;max-width:440px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
.hero-photo{background:#fff;border:1px solid var(--line);aspect-ratio:4/5;object-fit:cover;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-size:13px}

.trust{display:flex;flex-wrap:wrap;gap:14px 26px;margin-top:26px;color:var(--ink-soft);font-weight:500;font-size:13px}
.trust span{display:flex;align-items:center;gap:8px}
.trust span::before{content:'—';color:var(--accent)}

section{padding:66px 0;border-bottom:1px solid var(--line)}
.section-head{max-width:560px;margin:0 0 40px}
.section-head.center{text-align:center;margin-left:auto;margin-right:auto}
.eyebrow-c{display:block;color:var(--accent);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px;font-weight:600}
.section-head h2{font-size:28px;letter-spacing:-.01em}
.section-head p{color:var(--ink-soft);font-size:14.5px;margin-top:10px}

/* estilo distintivo: lista plana, no grid de tarjetas */
.menu-list{max-width:820px;margin:0 auto}
.menu-cat-name{font-family:var(--serif);font-weight:700;font-size:15px;color:var(--accent);text-transform:uppercase;letter-spacing:.06em;margin:34px 0 6px;padding-top:20px;border-top:1px solid var(--line)}
.menu-cat-name:first-child{margin-top:0;padding-top:0;border-top:none}
.dish-row{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:14px 0;border-bottom:1px solid var(--line)}
.dish-row .left{flex:1}
.dish-row .name{font-weight:600;font-size:15px}
.dish-row .desc{color:var(--ink-soft);font-size:13px;margin-top:3px}
.dish-row .price{font-family:var(--serif);font-weight:700;font-size:15px;white-space:nowrap}

.story-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:3rem;align-items:center}
@media(max-width:860px){.story-grid{grid-template-columns:1fr}}
.story-photo{object-fit:cover;aspect-ratio:1/1;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-size:13px}
.story-p{color:var(--ink-soft);font-size:14.5px;margin-bottom:14px}

.events{display:flex;flex-direction:column}
.event{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0;gap:14px;flex-wrap:wrap;border-bottom:1px solid var(--line)}
.event .date{font-family:var(--serif);font-weight:700;color:var(--accent);min-width:90px}
.event .what{font-weight:600;font-size:14.5px}
.event .desc{color:var(--ink-soft);font-size:13px}

.res-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem;align-items:stretch}
@media(max-width:860px){.res-grid{grid-template-columns:1fr}}
.res-card{background:#fff;border:1px solid var(--line);padding:1.8rem}
.res-card h3{color:var(--ink);font-size:17px;margin-bottom:8px}
.res-card p{color:var(--ink-soft);font-size:13.5px;margin-bottom:16px}

.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}
@media(max-width:760px){.gallery{grid-template-columns:repeat(2,1fr)}}
.gph{object-fit:cover;aspect-ratio:1/1;background:#fff;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-size:12px}

.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}
@media(max-width:760px){.reviews{grid-template-columns:1fr}}
.review{background:#fff;padding:1.6rem}
.review .stars{color:var(--accent);font-size:13px;margin-bottom:10px}
.review p{font-size:13.5px;color:var(--ink)}
.review .who{margin-top:14px;font-weight:700;font-size:12.5px;color:var(--ink-soft)}

.faq{max-width:720px}
.faq details{border-bottom:1px solid var(--line);padding:18px 0}
.faq summary{font-family:var(--serif);font-size:15px;font-weight:700;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';font-family:var(--sans);font-size:20px;color:var(--accent);flex:none;transition:.2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{color:var(--ink-soft);font-size:13.5px;margin-top:10px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1.1rem}
.citem{display:flex;gap:14px;align-items:flex-start}
.citem .ic{width:32px;height:32px;background:var(--accent-dim);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none;font-weight:700;font-size:13px}
.citem h4{font-size:14px;font-weight:700}
.citem p{font-size:13.5px;color:var(--ink-soft)}
.map-embed{border:1px solid var(--line);aspect-ratio:4/3}
.map-embed iframe{width:100%;height:100%;border:0}

.cta-final{padding:56px 0;text-align:center}
.cta-final h2{font-size:28px;margin-bottom:14px}
.cta-final p{color:var(--ink-soft);margin-bottom:22px}

footer{padding:28px 0;color:var(--ink-soft);font-size:12.5px}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:22px;flex-wrap:wrap}
.foot-links a:hover{color:var(--accent)}
.legal-note{max-width:760px;margin:16px auto 0;text-align:center;font-size:11.5px;color:#9A9A9A;line-height:1.6}

.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.2);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(250,250,250,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:12px}
@media(max-width:600px){.cta-bar{display:flex}}
.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--accent);color:#fff;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;opacity:.9;z-index:61}
@media(max-width:600px){.tpl-badge{bottom:78px}}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <div class="logo">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{^logo_url}}<span class="mark">{{inicial_negocio}}</span> {{nombre_negocio}}{{/logo_url}}</div>
    <nav><ul>
      <li><a href="carta.html">Carta</a></li>
      <li><a href="nosotros.html">Nosotros</a></li>
      {{#hay_events}}<li><a href="#eventos">Eventos</a></li>{{/hay_events}}
      <li><a href="contacto.html">Contacto</a></li>
    </ul></nav>
    <a class="btn btn-primary" href="#reservas">Reserva online</a>
  </div>
</header>

<section class="hero" style="border-bottom:1px solid var(--line)">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">{{eyebrow_hero}}</span>
      <h1>{{hero_title}}</h1>
      <p>{{hero_subtitle}}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#reservas">Reserva online</a>
        <a class="btn btn-ghost" href="#carta">Ver la carta</a>
      </div>
      <div class="trust">{{#trust_badges}}<span>{{.}}</span>{{/trust_badges}}</div>
    </div>
    {{#foto_hero_url}}<img class="hero-photo" src="{{foto_hero_url}}" alt="{{nombre_negocio}}">{{/foto_hero_url}}{{^foto_hero_url}}<div class="hero-photo">Foto del plato</div>{{/foto_hero_url}}
  </div>
</section>

<section id="carta"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">01 — Carta</span><h2>Ingredientes, sin adornos</h2><p>{{lead_carta}}</p></div>
  {{#preview}}
  <div style="display:flex;gap:10px;margin-bottom:1.6rem;flex-wrap:wrap">
    <span style="padding:7px 14px;font-size:12px;font-weight:600;background:var(--accent);color:#fff">Carta completa</span>
    <span style="padding:7px 14px;font-size:12px;font-weight:600;color:var(--ink-soft);border:1px solid var(--line)">+ Descarga en PDF — próximamente</span>
  </div>
  {{/preview}}
  <div class="menu-list">{{#menu_cats}}<div class="menu-cat-name">{{categoria}}</div>{{#platos}}<div class="dish-row"><div class="left"><div class="name">{{nombre}}</div>{{#descripcion}}<div class="desc">{{descripcion}}</div>{{/descripcion}}</div><div class="price">{{precio}}</div></div>{{/platos}}{{/menu_cats}}</div>
</div></section>

<section id="nosotros"><div class="wrap">
  <div class="section-head center"><span class="eyebrow-c">02 — Nosotros</span><h2>Nuestra filosofía</h2></div>
  <div class="story-grid">
    {{#foto_secundaria_url}}<img class="story-photo" src="{{foto_secundaria_url}}" alt="{{nombre_negocio}}">{{/foto_secundaria_url}}{{^foto_secundaria_url}}<div class="story-photo">Foto de la sala</div>{{/foto_secundaria_url}}
    <div><p class="story-p">{{historia_p1}}</p><p class="story-p">{{historia_p2}}</p></div>
  </div>
</div></section>

{{#hay_events}}
<section id="eventos"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">03 — Agenda</span><h2>Próximos eventos</h2></div>
  <div class="events">{{#events}}<div class="event"><div class="date">{{fecha}}</div><div class="what">{{what}}</div><div class="desc">{{desc}}</div></div>{{/events}}</div>
</div></section>
{{/hay_events}}

<section id="reservas"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">04 — Reservas</span><h2>Cómo reservar</h2><p>Recomendamos WhatsApp para respuesta inmediata.</p></div>
  <div class="res-grid">
    <div class="res-card"><h3>Reserva directa</h3><p>{{res_directa_texto}}</p><a href="https://wa.me/{{telefono_wa}}" class="btn btn-primary">Reservar por WhatsApp</a></div>
    <div class="res-card"><h3>Plataformas externas</h3><p>También disponible en tu plataforma de reservas habitual.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap"><a href="#" class="btn btn-ghost">TheFork</a><a href="#" class="btn btn-ghost">Google Reservations</a></div>
      {{#preview}}<p style="margin-top:14px;font-size:11.5px;color:var(--ink-soft)">Función ampliable: integración con motor de reservas externo en tiempo real.</p>{{/preview}}
    </div>
  </div>
</div></section>

<section><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">05 — Galería</span><h2>Sala y platos</h2></div>
  <div class="gallery">{{#galeria}}<img class="gph" src="{{url}}">{{/galeria}}{{^galeria}}<div class="gph">Foto</div><div class="gph">Foto</div><div class="gph">Foto</div><div class="gph">Foto</div>{{/galeria}}</div>
</div></section>

{{#hay_reviews}}
<section><div class="wrap">
  <div class="section-head center"><span class="eyebrow-c">06 — Opiniones</span><h2>Lo que dicen</h2></div>
  <div class="reviews">{{#reviews}}<div class="review"><div class="stars">★★★★★</div><p>&quot;{{cita}}&quot;</p><div class="who">{{nombre}}</div></div>{{/reviews}}</div>
</div></section>
{{/hay_reviews}}

{{#hay_faqs}}
<section id="faq"><div class="wrap" style="max-width:720px">
  <div class="section-head"><span class="eyebrow-c">07 — FAQ</span><h2>Preguntas frecuentes</h2></div>
  <div class="faq">{{#faqs}}<details><summary>{{pregunta}}</summary><p>{{respuesta}}</p></details>{{/faqs}}</div>
</div></section>
{{/hay_faqs}}

<section id="contacto"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">08 — Contacto</span><h2>Dónde estamos</h2></div>
  <div class="contact-grid">
    <div class="contact-list">
      <div class="citem"><div class="ic">P</div><div><h4>Ciudad</h4><p>{{ciudad}}</p></div></div>
      <div class="citem"><div class="ic">T</div><div><h4>Teléfono</h4><p>{{telefono}}</p></div></div>
      <div class="citem"><div class="ic">E</div><div><h4>Email</h4><p>{{email}}</p></div></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-ghost" style="margin-top:6px;width:fit-content">Escribir por WhatsApp</a>
    </div>
    <div class="map-embed"><iframe src="https://www.google.com/maps?q={{ciudad_url}},Spain&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section style="border-bottom:none"><div class="wrap">
  <div class="cta-final">
    <h2>Reserva tu mesa</h2>
    <p>Cocina de producto, carta corta, sin ruido.</p>
    <a class="btn btn-primary" href="#reservas">Reserva online</a>
  </div>
</div></section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Hostelería</div>
      <div class="foot-links"><a href="aviso-legal.html">Aviso legal</a><a href="privacidad.html">Política de privacidad</a><a href="cookies.html">Cookies</a></div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar"><a href="tel:{{telefono}}" class="btn btn-ghost">Llamar</a><a href="#reservas" class="btn btn-primary">Reservar</a></div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Reservar por WhatsApp">
  <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.485 1.34 5.003l-1.42 5.183 5.309-1.394a9.96 9.96 0 0 0 4.768 1.214h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.935 9.935 0 0 0-7.072-2.937zm5.878 15.845a8.257 8.257 0 0 1-4.879 1.535h-.003a8.276 8.276 0 0 1-4.217-1.155l-.303-.18-3.15.827.84-3.07-.198-.315a8.234 8.234 0 0 1-1.264-4.398c0-4.564 3.713-8.277 8.28-8.277a8.226 8.226 0 0 1 5.856 2.428 8.222 8.222 0 0 1 2.42 5.857c0 4.564-3.713 8.276-8.28 8.276z"/></svg>
</a>

</body>
</html>
