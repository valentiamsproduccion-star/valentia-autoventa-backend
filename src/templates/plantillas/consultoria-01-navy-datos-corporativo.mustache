<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0B1D3A">
<title>{{nombre_negocio}} — Consultoría estratégica</title>
<meta name="description" content="{{hero_subtitle}}">
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · SERVICIOS PROFESIONALES · Consultoría
   Diseño 1: Navy datos corporativo
   ═══════════════════════════════════════ */
:root{
  --accent:#C9A227; --accent-mid:#A8871F; --accent-dim:#F5EFD9;
  --ink:#131A24; --ink-soft:#5B6472; --cream:#FFFFFF; --white-pure:#F5F6F8; --line:#DCE1E8;
  --navy:#0B1D3A; --steel:#3B5B8C;
  --serif:'Space Grotesk',sans-serif; --sans:'Inter',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);background:var(--cream);color:var(--ink);line-height:1.6}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:700;letter-spacing:-.01em}
.wrap{max-width:1160px;margin:0 auto;padding:0 24px}
header{padding:22px 0;position:absolute;top:0;left:0;right:0;z-index:5}
.nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:var(--serif);font-weight:700;font-size:18px;color:#fff;letter-spacing:.01em;display:flex;align-items:center;gap:9px}
.logo img{height:30px;width:auto;display:block}
.logo span{color:var(--accent)}
nav ul{list-style:none;display:flex;gap:28px;font-size:13px;color:rgba(255,255,255,.82);font-weight:500}
nav ul a{color:inherit;text-decoration:none}
nav ul a:hover{color:#fff}
.btn{display:inline-block;padding:12px 24px;border-radius:2px;font-size:13px;font-weight:600;text-decoration:none;border:none;cursor:pointer;text-align:center}
.btn-primary{background:var(--accent);color:#171200}
.btn-primary:hover{background:var(--accent-mid)}
.btn-ghost{color:#fff;border:1px solid rgba(255,255,255,.35);background:transparent}
.btn-ghost:hover{border-color:var(--accent)}
@media(max-width:760px){nav ul{display:none}}

.hero{position:relative;min-height:600px;background:linear-gradient(180deg,rgba(11,29,58,.2),rgba(11,29,58,.9)),linear-gradient(135deg,#1B3A63,#0B1D3A);display:flex;align-items:center;overflow:hidden;padding:150px 0 80px}
.hero-inner{position:relative;z-index:1;max-width:620px}
.eyebrow{display:inline-block;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);color:#fff;font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding:7px 15px;margin-bottom:20px}
.hero h1{font-size:44px;line-height:1.15;color:#fff;margin-bottom:18px}
.hero p{color:rgba(255,255,255,.78);font-size:16px;max-width:480px;margin-bottom:30px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
.stat-bar{position:relative;background:rgba(0,0,0,.28);padding:18px 24px;margin-top:40px;display:inline-flex;flex-wrap:wrap;gap:30px;border-radius:4px}
.stat-bar span{font-size:13px;color:#E7EAF0}

section.blk{padding:76px 0}
.alt-bg{background:var(--white-pure)}
.section-head{margin-bottom:42px;max-width:600px}
.section-head.centered{text-align:center;margin:0 auto 42px}
.eyebrow-c{display:inline-block;color:var(--steel);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px}
.section-head h2{font-size:30px}
.section-head p{color:var(--ink-soft);font-size:15px;margin-top:10px}

.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:2px solid var(--navy)}
@media(max-width:860px){.grid-3{grid-template-columns:1fr}}
.card{padding:30px 26px;border-right:1px solid var(--line)}
.card:last-child{border-right:none}
@media(max-width:860px){.card{border-right:none;border-bottom:1px solid var(--line)}}
.card .num{font-family:var(--serif);font-size:13px;color:var(--accent-mid);font-weight:700;margin-bottom:14px;display:block}
.card h3{font-size:18px;margin-bottom:10px}
.card p{color:var(--ink-soft);font-size:14px}

.team{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:2px solid var(--navy)}
@media(max-width:760px){.team{grid-template-columns:1fr 1fr}}
.member{text-align:center;padding:26px 14px;border-right:1px solid var(--line)}
@media(max-width:760px){.member{border-right:none;border-bottom:1px solid var(--line)}}
.member .ph{width:56px;height:56px;border-radius:2px;margin:0 auto 12px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:700;font-size:15px}
.member .name{font-weight:600;font-size:14px}
.member .rol{color:var(--ink-soft);font-size:12px;margin-top:2px}
.member .cred{color:var(--ink-soft);font-size:11px;margin-top:5px;opacity:.75}

.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:0;background:var(--navy)}
@media(max-width:860px){.steps{grid-template-columns:1fr}}
.step{padding:34px 28px;color:#fff;border-right:1px solid rgba(255,255,255,.12)}
.step:last-child{border-right:none}
@media(max-width:860px){.step{border-right:none;border-bottom:1px solid rgba(255,255,255,.12)}}
.step .n{font-family:var(--serif);font-size:30px;font-weight:700;color:var(--accent);margin-bottom:10px;display:block}
.step h3{font-size:16px;color:#fff;margin-bottom:8px}
.step p{color:rgba(255,255,255,.68);font-size:13.5px}

.consulta-form-wrap{margin-top:40px;display:flex;justify-content:center}
.form-card{background:#fff;border:1px solid var(--line);padding:2rem;max-width:520px;width:100%}
.form-card label{font-weight:600;color:var(--ink);font-size:13px;display:block;margin-bottom:6px}
.field{margin-bottom:14px}
.field input,.field select,.field textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:2px;font-size:14.5px;font-family:var(--sans);outline:none;background:var(--white-pure);color:var(--ink)}
.field textarea{resize:vertical;min-height:80px}
.form-note{font-size:12px;color:var(--ink-soft);margin-top:10px;line-height:1.5}

.testis{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
@media(max-width:760px){.testis{grid-template-columns:1fr}}
.testi{background:#fff;border:1px solid var(--line);padding:1.6rem}
.testi p{font-size:14px;color:var(--ink);font-style:italic}
.testi .who{margin-top:12px;font-weight:700;font-size:12.5px}
.testi .who span{display:block;font-weight:500;color:var(--ink-soft);font-size:11.5px;margin-top:1px}

.faq-item{border-bottom:1px solid var(--line);padding:20px 0}
.faq-item summary{font-weight:600;font-size:15px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:'+';font-size:20px;color:var(--accent-mid);flex:none}
.faq-item[open] summary::after{content:'−'}
.faq-item p{color:var(--ink-soft);font-size:14px;margin-top:10px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1rem}
.citem{display:flex;gap:14px;align-items:flex-start}
.citem .ic{width:32px;height:32px;background:var(--navy);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none;font-weight:700;font-size:13px}
.citem h4{font-size:14px;font-weight:600}
.citem p{font-size:13.5px;color:var(--ink-soft)}
.map-embed{border:1px solid var(--line);aspect-ratio:4/3}
.map-embed iframe{width:100%;height:100%;border:0}

.cta-final{background:var(--white-pure);text-align:center;padding:64px 40px;border:1px solid var(--line);margin:0 24px}
.cta-final h2{font-size:28px;margin-bottom:12px}
.cta-final p{color:var(--ink-soft);margin-bottom:24px}
.cta-final .btn-primary{background:var(--navy);color:#fff}

footer{padding:30px 0;color:var(--ink-soft);font-size:13px}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:22px;flex-wrap:wrap}
.foot-links a:hover{color:var(--navy)}
.legal-note{max-width:760px;margin:16px auto 0;text-align:center;font-size:11.5px;color:#9AA1B0;line-height:1.6}

.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.25);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:12px;color:var(--ink);border:1px solid var(--line)}
.cta-bar .btn-primary{color:#fff;border-color:var(--navy);background:var(--navy)}
@media(max-width:600px){.cta-bar{display:flex}}
.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--navy);color:#fff;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;opacity:.85;z-index:61;font-family:var(--sans)}
@media(max-width:600px){.tpl-badge{bottom:78px}}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <div class="logo">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{^logo_url}}{{nombre_negocio}}{{/logo_url}}</div>
    <nav><ul>
      <li><a href="areas.html">Servicios</a></li>
      <li><a href="#equipo">Metodología</a></li>
      <li><a href="equipo.html">Equipo</a></li>
      {{#hay_faqs}}<li><a href="#faq">FAQ</a></li>{{/hay_faqs}}
    </ul></nav>
    <a class="btn btn-ghost" href="#consulta">Agenda un diagnóstico</a>
  </div>
</header>

<section class="hero"><div class="wrap hero-inner">
  <span class="eyebrow">{{eyebrow_hero}}</span>
  <h1>{{hero_title}}</h1>
  <p>{{hero_subtitle}}</p>
  <div class="hero-cta">
    <a class="btn btn-primary" href="#consulta">Agenda un diagnóstico</a>
    <a class="btn btn-ghost" href="areas.html">Ver servicios</a>
  </div>
  <div class="stat-bar">{{#trust_badges}}<span>{{.}}</span>{{/trust_badges}}</div>
</div></section>

<section class="blk" id="areas"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Servicios</span><h2>{{h2_areas}}</h2><p>{{lead_areas}}</p></div>
  <div class="grid-3">{{#areas}}<div class="card"><span class="num">{{n}}</span><h3>{{titulo}}</h3><p>{{descripcion}}</p></div>{{/areas}}</div>
</div></section>

<section class="blk" id="equipo"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Metodología</span><h2>Cómo trabajamos</h2></div>
</div>
<div class="steps">{{#consulta_points}}<div class="step"><span class="n">{{n}}</span><h3>{{titulo}}</h3><p>{{descripcion}}</p></div>{{/consulta_points}}</div>
</section>

<section class="blk alt-bg"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Equipo</span><h2>Quién lleva tu proyecto</h2></div>
  <div class="team">{{#equipo}}<div class="member">{{#foto_url}}<img class="ph" src="{{foto_url}}" alt="{{nombre}}">{{/foto_url}}{{^foto_url}}<div class="ph">{{inicial_negocio}}</div>{{/foto_url}}<div class="name">{{nombre}}</div><div class="rol">{{rol}}</div><p class="cred">{{credencial}}</p></div>{{/equipo}}</div>
</div></section>

<section class="blk" id="consulta"><div class="wrap">
  <div class="section-head centered"><span class="eyebrow-c">Diagnóstico</span><h2>{{h2_consulta}}</h2><p style="color:var(--ink-soft);font-size:15.5px;margin-top:8px">{{lead_consulta}}</p></div>
  <div class="consulta-form-wrap">
    <div class="form-card">
      <div class="field"><label>Servicio que te interesa</label><select name="area">{{#areas}}<option>{{titulo}}</option>{{/areas}}<option>No lo sé todavía</option></select></div>
      <div class="field"><label>Nombre</label><input type="text" placeholder="Tu nombre"></div>
      <div class="field"><label>Teléfono o email</label><input type="text" placeholder="Cómo te contactamos"></div>
      <div class="field"><label>Cuéntanos brevemente tu situación</label><textarea placeholder="Escribe aquí..."></textarea></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-primary" style="width:100%;display:block;text-align:center">Agenda tu llamada</a>
      <p class="form-note">Al enviar este formulario aceptas nuestra política de privacidad. Tus datos se tratan conforme al RGPD y no se ceden a terceros.</p>
    </div>
  </div>
</div></section>

{{#hay_testimonios}}
<section class="blk alt-bg"><div class="wrap">
  <div class="section-head centered"><span class="eyebrow-c">Opiniones</span><h2>Lo que dicen nuestros clientes</h2></div>
  <div class="testis">{{#testimonios}}<div class="testi"><p>&quot;{{cita}}&quot;</p><div class="who">{{nombre}}<span>{{contexto}}</span></div></div>{{/testimonios}}</div>
</div></section>
{{/hay_testimonios}}

{{#hay_faqs}}
<section class="blk" id="faq"><div class="wrap" style="max-width:740px">
  <div class="section-head"><span class="eyebrow-c">Preguntas frecuentes</span><h2>Antes de que preguntes</h2></div>
  {{#faqs}}<details class="faq-item"><summary>{{pregunta}}</summary><p>{{respuesta}}</p></details>{{/faqs}}
</div></section>
{{/hay_faqs}}

<section class="blk alt-bg" id="contacto"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Contacto</span><h2>Hablemos</h2></div>
  <div class="contact-grid">
    <div class="contact-list">
      <div class="citem"><div class="ic">📍</div><div><h4>Ciudad</h4><p>{{ciudad}}</p></div></div>
      <div class="citem"><div class="ic">☎</div><div><h4>Teléfono</h4><p>{{telefono}}</p></div></div>
      <div class="citem"><div class="ic">✉</div><div><h4>Email</h4><p>{{email}}</p></div></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-ghost" style="margin-top:6px;width:fit-content;color:var(--ink);border-color:var(--line)">Escribir por WhatsApp</a>
    </div>
    <div class="map-embed"><iframe src="https://www.google.com/maps?q={{ciudad_url}},Spain&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section class="blk"><div class="wrap">
  <div class="cta-final">
    <h2>¿Empezamos con tu diagnóstico?</h2>
    <p>Una primera llamada de 30 minutos, sin compromiso, para ver si podemos ayudarte.</p>
    <a class="btn btn-primary" href="https://wa.me/{{telefono_wa}}">Agenda tu llamada</a>
  </div>
</div></section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Consultoría estratégica</div>
      <div class="foot-links"><a href="aviso-legal.html">Aviso legal</a><a href="privacidad.html">Política de privacidad</a><a href="cookies.html">Cookies</a></div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar"><a href="tel:{{telefono}}" class="btn">Llamar</a><a href="#consulta" class="btn btn-primary">Diagnóstico</a></div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.485 1.34 5.003l-1.42 5.183 5.309-1.394a9.96 9.96 0 0 0 4.768 1.214h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.935 9.935 0 0 0-7.072-2.937zm5.878 15.845a8.257 8.257 0 0 1-4.879 1.535h-.003a8.276 8.276 0 0 1-4.217-1.155l-.303-.18-3.15.827.84-3.07-.198-.315a8.234 8.234 0 0 1-1.264-4.398c0-4.564 3.713-8.277 8.28-8.277a8.226 8.226 0 0 1 5.856 2.428 8.222 8.222 0 0 1 2.42 5.857c0 4.564-3.713 8.276-8.28 8.276z"/></svg>
</a>

</body>
</html>
