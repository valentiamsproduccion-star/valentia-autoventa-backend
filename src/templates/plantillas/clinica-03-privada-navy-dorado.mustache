<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0D1B33">
<title>{{nombre_negocio}} — Salud y bienestar</title>
<meta name="description" content="{{hero_subtitle}}">
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · SALUD Y BIENESTAR · Clínica
   Diseño 3: Privada navy dorado
   ═══════════════════════════════════════ */
:root{
  --accent:#C9A227; --accent-mid:#A9860E; --accent-dim:rgba(201,162,39,.12);
  --ink:#12161F; --ink-soft:#5B6472; --cream:#fff; --white-pure:#fff; --line:#DCE1E8;
  --serif:'Playfair Display',serif; --sans:'Inter',sans-serif;
  --navy:#0D1B33;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);color:var(--ink);line-height:1.6;background:var(--cream)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:700}
.wrap{max-width:1150px;margin:0 auto;padding:0 24px}
header{padding:22px 0;position:absolute;top:0;left:0;right:0;z-index:5}
.nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:var(--serif);font-weight:700;font-size:19px;color:#fff;display:flex;align-items:center;gap:9px}
.logo img{height:32px;width:auto;display:block}
.logo .mark{width:30px;height:30px;border-radius:50%;background:var(--accent);color:var(--navy);display:flex;align-items:center;justify-content:center;font-size:13px;font-family:var(--serif)}
.logo span{color:var(--accent)}
nav ul{list-style:none;display:flex;gap:26px;font-size:13px;color:rgba(255,255,255,.8)}
nav ul a{color:inherit;text-decoration:none}
nav ul a:hover{color:var(--accent)}
.btn{display:inline-block;padding:12px 24px;font-size:13px;font-weight:600;text-decoration:none;border:none;cursor:pointer;text-align:center}
.btn-primary{background:var(--accent);color:#171200}
.btn-primary:hover{background:var(--accent-mid)}
.btn-ghost{color:#fff;border:1px solid rgba(255,255,255,.35);background:transparent}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
@media(max-width:760px){nav ul{display:none}}

.hero{position:relative;min-height:560px;background:linear-gradient(180deg,rgba(13,27,51,.2),rgba(13,27,51,.92)),linear-gradient(135deg,#1B345C,var(--navy));display:flex;align-items:center;overflow:hidden}
.hero-photo{position:absolute;right:0;bottom:0;top:0;width:42%;object-fit:cover;opacity:.5}
@media(max-width:860px){.hero-photo{display:none}}
.hero-inner{position:relative;z-index:1;max-width:600px;padding:120px 0 70px}
.eyebrow{display:inline-block;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);color:#fff;font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding:7px 15px;margin-bottom:18px}
.hero h1{font-size:38px;line-height:1.2;color:#fff;margin-bottom:16px}
.hero p{color:rgba(255,255,255,.75);font-size:15.5px;max-width:460px;margin-bottom:26px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}

section{padding:64px 0}
.section-head{margin-bottom:36px;max-width:600px}
.eyebrow-c{display:inline-block;color:var(--navy);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px}
.section-head p{color:var(--ink-soft);font-size:15px;margin-top:10px}

.treats{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:2px solid var(--navy)}
@media(max-width:820px){.treats{grid-template-columns:1fr}}
.treat{padding:26px;border-right:1px solid var(--line)}
.treat:last-child{border-right:none}
.treat .ic{color:var(--accent);font-weight:700;font-size:12.5px}
.treat h3{font-size:17px;margin:10px 0 8px}
.treat p{color:var(--ink-soft);font-size:14px}

.team{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;margin-top:3rem}
@media(max-width:760px){.team{grid-template-columns:1fr}}
.member{background:#F7F6F3;border-radius:4px;overflow:hidden}
.member .ph{object-fit:cover;aspect-ratio:4/5;background:var(--navy);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.4);font-family:var(--serif);font-size:13px}
.member .info{padding:1.3rem 1.4rem}
.member h3{font-size:16px;font-weight:700}
.member .role{color:var(--accent-mid);font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.05em;margin-top:2px}
.member .cred{color:var(--ink-soft);font-size:13px;margin-top:8px}

.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:0;background:var(--navy)}
@media(max-width:860px){.steps{grid-template-columns:1fr}}
.step{padding:28px 24px;color:#fff;border-right:1px solid rgba(255,255,255,.12)}
.step:last-child{border-right:none}
.step .n{color:var(--accent);font-weight:700;font-size:26px;display:block;margin-bottom:8px}
.step h3{font-size:15px;color:#fff;margin-bottom:6px}
.step p{color:rgba(255,255,255,.65);font-size:13px}

.cita{background:#F7F6F3}
.cita .section-head p{color:var(--ink-soft)}
.cita-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin-top:2.5rem;align-items:start}
@media(max-width:860px){.cita-grid{grid-template-columns:1fr}}
.cita-points{display:flex;flex-direction:column;gap:1.3rem}
.cpoint{display:flex;gap:14px}
.cpoint .ic{width:34px;height:34px;background:var(--accent-dim);flex:none;display:flex;align-items:center;justify-content:center;color:var(--accent-mid);font-weight:700;font-size:14px}
.cpoint h4{font-size:15px;font-weight:700;color:var(--navy);font-family:var(--serif)}
.cpoint p{font-size:13.5px;color:var(--ink-soft);margin-top:3px}
.form-card{background:#fff;padding:1.8rem}
.form-card label{font-weight:600;color:var(--ink);font-size:13.5px;display:block;margin-bottom:6px}
.field{margin-bottom:14px}
.field input,.field select,.field textarea{width:100%;padding:12px 14px;border:1px solid var(--line);font-size:14.5px;font-family:var(--sans);outline:none;background:#F7F6F3;color:var(--ink)}
.field textarea{resize:vertical;min-height:70px}
.form-note{font-size:11.5px;color:var(--ink-soft);margin-top:10px;line-height:1.5}

.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:1.3rem;margin-top:3rem}
@media(max-width:760px){.reviews{grid-template-columns:1fr}}
.review{background:#fff;border:1px solid var(--line);padding:1.6rem}
.review .stars{color:var(--accent-mid);font-size:14px;margin-bottom:10px}
.review p{font-size:14.5px;color:var(--ink-soft);font-style:italic}
.review .who{margin-top:14px;font-weight:700;font-size:13px}

.faq{margin-top:0;max-width:740px}
.faq details{border-bottom:1px solid var(--line);padding:18px 0}
.faq summary{font-size:14.5px;font-weight:600;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';font-size:20px;color:var(--accent-mid);flex:none;transition:.2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{color:var(--ink-soft);font-size:13.5px;margin-top:10px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;margin-top:2.5rem;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1.1rem}
.citem{display:flex;gap:14px;align-items:flex-start}
.citem .ic{width:34px;height:34px;background:var(--accent-dim);color:var(--accent-mid);display:flex;align-items:center;justify-content:center;flex:none;font-weight:700;font-size:14px}
.citem h4{font-size:14.5px;font-weight:700}
.citem p{font-size:13.5px;color:var(--ink-soft)}
.map-embed{overflow:hidden;border:1px solid var(--line);aspect-ratio:4/3}
.map-embed iframe{width:100%;height:100%;border:0}

.cta-final{background:#F7F6F3;text-align:center;padding:56px 40px;margin:0 24px}
.cta-final h2{font-size:26px;margin-bottom:10px}
.cta-final p{color:var(--ink-soft);margin-bottom:20px}
.cta-final .btn-primary{background:var(--navy);color:#fff}

footer{padding:26px 0;color:var(--ink-soft);font-size:12.5px}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:20px;flex-wrap:wrap}
.foot-links a:hover{color:var(--accent-mid)}
.legal-note{max-width:820px;margin:16px auto 0;text-align:center;font-size:11.5px;color:#999;line-height:1.6}

.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.25);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:12px}
@media(max-width:600px){.cta-bar{display:flex}}
.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--navy);color:#fff;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;border-radius:100px;opacity:.85;z-index:61;font-family:var(--sans)}
@media(max-width:600px){.tpl-badge{bottom:78px}}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <div class="logo">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{^logo_url}}<span class="mark">{{inicial_negocio}}</span> {{nombre_negocio}}{{/logo_url}}</div>
    <nav><ul>
      <li><a href="tratamientos.html">Servicios</a></li>
      <li><a href="equipo.html">Equipo</a></li>
      <li><a href="contacto.html">Contacto</a></li>
    </ul></nav>
    <a class="btn btn-ghost" href="#cita">Solicitar valoración</a>
  </div>
</header>

<section class="hero">
  {{#foto_hero_url}}<img class="hero-photo" src="{{foto_hero_url}}" alt="{{nombre_negocio}}">{{/foto_hero_url}}
  <div class="wrap hero-inner">
    <span class="eyebrow">{{eyebrow_hero}}</span>
    <h1>{{hero_title}}</h1>
    <p>{{hero_subtitle}}</p>
    <div class="hero-cta"><a class="btn btn-primary" href="#cita">Solicitar valoración</a></div>
  </div>
</section>

<section id="tratamientos"><div class="wrap">
  <div class="section-head"><div class="eyebrow-c">Servicios</div><h2>{{h2_tratamientos}}</h2><p>{{lead_tratamientos}}</p></div>
  <div class="treats">
    {{#treats}}<div class="treat"><span class="ic">{{n}}</span><h3>{{titulo}}</h3><p>{{descripcion}}</p></div>{{/treats}}
  </div>
</div></section>

<section id="equipo"><div class="wrap">
  <div class="section-head"><div class="eyebrow-c">Equipo</div><h2>Quién te va a atender</h2><p>Especialistas de referencia en cada área.</p></div>
  <div class="team">
    {{#equipo}}<div class="member">
      {{#foto_url}}<img class="ph" src="{{foto_url}}" alt="{{nombre}}">{{/foto_url}}{{^foto_url}}<div class="ph">Foto</div>{{/foto_url}}
      <div class="info"><h3>{{nombre}}</h3><div class="role">{{rol}}</div><p class="cred">{{credencial}}</p></div>
    </div>{{/equipo}}
  </div>
</div></section>

<section id="proceso"><div class="wrap"><div class="section-head"><div class="eyebrow-c">Proceso</div><h2>Cómo empezamos</h2></div></div>
<div class="steps">
  <div class="step"><span class="n">01</span><h3>Valoración inicial</h3><p>Entrevista médica y revisión de tu historial.</p></div>
  <div class="step"><span class="n">02</span><h3>Plan personalizado</h3><p>Diseñamos el itinerario de pruebas y especialistas.</p></div>
  <div class="step"><span class="n">03</span><h3>Acompañamiento</h3><p>Tu gestor coordina cada cita y cada resultado.</p></div>
</div></section>

<section class="cita" id="cita"><div class="wrap">
  <div class="section-head" style="max-width:640px;margin:0 0 2.5rem"><div class="eyebrow-c">Solicitar valoración</div><h2 style="color:var(--navy)">{{h2_cita}}</h2><p>{{lead_cita}}</p></div>
  <div class="cita-grid">
    <div class="cita-points">
      {{#cita_points}}<div class="cpoint"><div class="ic">{{n}}</div><div><h4>{{titulo}}</h4><p>{{descripcion}}</p></div></div>{{/cita_points}}
    </div>
    <div class="form-card">
      <div class="field">
        <label>Servicio</label>
        <select name="servicio">
          {{#treats}}<option>{{titulo}}</option>{{/treats}}
          <option>No lo sé, quiero que me orienten</option>
        </select>
      </div>
      <div class="field"><label>Nombre</label><input type="text" placeholder="Tu nombre"></div>
      <div class="field"><label>Teléfono o email</label><input type="text" placeholder="Cómo te contactamos"></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-primary" style="width:100%;text-align:center">Enviar solicitud</a>
      <p class="form-note">Tus datos se tratan con confidencialidad conforme al RGPD.{{#preview}} <br>Función ampliable: gestor personal asignado desde la primera llamada.{{/preview}}</p>
    </div>
  </div>
</div></section>

{{#hay_reviews}}
<section><div class="wrap">
  <div class="section-head"><div class="eyebrow-c">Opiniones</div><h2>Lo que dicen nuestros pacientes</h2></div>
  <div class="reviews">
    {{#reviews}}<div class="review"><div class="stars">★★★★★</div><p>&quot;{{cita}}&quot;</p><div class="who">{{nombre}}</div></div>{{/reviews}}
  </div>
</div></section>
{{/hay_reviews}}

{{#hay_faqs}}
<section id="faq"><div class="wrap" style="max-width:740px">
  <div class="section-head"><div class="eyebrow-c">Preguntas frecuentes</div><h2>Antes de que preguntes</h2></div>
  <div class="faq">
    {{#faqs}}<details><summary>{{pregunta}}</summary><p>{{respuesta}}</p></details>{{/faqs}}
  </div>
</div></section>
{{/hay_faqs}}

<section id="contacto"><div class="wrap">
  <div class="section-head" style="margin:0 0 2rem"><div class="eyebrow-c">Contacto</div><h2>Visítanos o escríbenos</h2></div>
  <div class="contact-grid">
    <div class="contact-list">
      <div class="citem"><div class="ic">📍</div><div><h4>Ciudad</h4><p>{{ciudad}}</p></div></div>
      <div class="citem"><div class="ic">☎</div><div><h4>Teléfono</h4><p>{{telefono}}</p></div></div>
      <div class="citem"><div class="ic">✉</div><div><h4>Email</h4><p>{{email}}</p></div></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-ghost" style="margin-top:6px;width:fit-content;color:var(--navy);border-color:var(--navy)">Escribir por WhatsApp</a>
    </div>
    <div class="map-embed"><iframe src="https://www.google.com/maps?q={{ciudad_url}},Spain&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section><div class="wrap">
  <div class="cta-final">
    <h2>¿Solicitamos tu valoración?</h2>
    <p>Una primera llamada confidencial para diseñar tu plan de salud.</p>
    <a class="btn btn-primary" href="#cita">Solicitar valoración</a>
  </div>
</div></section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Salud y bienestar</div>
      <div class="foot-links">
        <a href="aviso-legal.html">Aviso legal</a>
        <a href="privacidad.html">Política de privacidad</a>
        <a href="cookies.html">Cookies</a>
      </div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar">
  <a href="tel:{{telefono}}" class="btn btn-ghost" style="color:var(--navy);border-color:var(--navy)">Llamar</a>
  <a href="#cita" class="btn btn-primary">Valoración</a>
</div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.485 1.34 5.003l-1.42 5.183 5.309-1.394a9.96 9.96 0 0 0 4.768 1.214h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.935 9.935 0 0 0-7.072-2.937zm5.878 15.845a8.257 8.257 0 0 1-4.879 1.535h-.003a8.276 8.276 0 0 1-4.217-1.155l-.303-.18-3.15.827.84-3.07-.198-.315a8.234 8.234 0 0 1-1.264-4.398c0-4.564 3.713-8.277 8.28-8.277a8.226 8.226 0 0 1 5.856 2.428 8.222 8.222 0 0 1 2.42 5.857c0 4.564-3.713 8.276-8.28 8.276z"/></svg>
</a>

</body>
</html>
