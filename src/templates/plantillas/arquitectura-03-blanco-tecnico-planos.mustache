<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1E4FD8">
<title>{{nombre_negocio}} — Estudio de arquitectura</title>
<meta name="description" content="{{hero_subtitle}}">
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · SERVICIOS PROFESIONALES · Arquitectura
   Diseño 3: Blanco técnico con planos
   ═══════════════════════════════════════ */
:root{
  --accent:#1E4FD8; --accent-mid:#173CA6; --accent-dim:#E9EFFC;
  --ink:#171A1F; --ink-soft:#666666; --cream:#FFFFFF; --white-pure:#F7F9FC; --line:#E0E4EC;
  --serif:'Inter',sans-serif; --sans:'Inter',sans-serif; --mono:'Space Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);color:var(--ink);line-height:1.6;background:var(--cream)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:700;letter-spacing:-.01em}
.wrap{max-width:1140px;margin:0 auto;padding:0 24px}
header{padding:22px 0;border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:var(--mono);font-weight:700;font-size:17px;display:flex;align-items:center;gap:9px}
.logo img{height:30px;width:auto;display:block}
.logo span{color:var(--accent)}
nav ul{list-style:none;display:flex;gap:26px;font-size:13.5px;color:#333;font-weight:500}
nav ul a{color:inherit;text-decoration:none}
nav ul a:hover{color:var(--accent)}
.btn{display:inline-block;padding:12px 22px;border-radius:2px;font-size:13px;font-weight:700;text-decoration:none;border:none;cursor:pointer;text-align:center}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent-mid)}
.btn-ghost{color:var(--ink);border:1px solid var(--line);background:transparent}
.btn-ghost:hover{border-color:var(--accent)}
@media(max-width:760px){nav ul{display:none}}

.hero{padding:70px 0 60px;background-image:linear-gradient(rgba(30,79,216,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(30,79,216,.06) 1px,transparent 1px);background-size:34px 34px}
.hero-inner{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center}
@media(max-width:860px){.hero-inner{grid-template-columns:1fr}}
.eyebrow{font-family:var(--mono);color:var(--accent);font-weight:700;font-size:12.5px;letter-spacing:.06em;margin-bottom:16px;display:block}
.hero h1{font-size:42px;line-height:1.16;margin-bottom:18px}
.hero p{color:var(--ink-soft);font-size:16px;margin-bottom:26px;max-width:460px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:20px}
.trust{display:flex;flex-wrap:wrap;gap:12px 22px;color:var(--ink-soft);font-family:var(--mono);font-size:12px}
.hero-photo{border:1px solid var(--accent);border-radius:2px;padding:20px;background:#fff;position:relative;aspect-ratio:4/3;object-fit:cover}
.hero-photo-wrap{border:1px solid var(--accent);border-radius:2px;padding:20px;background:#fff;position:relative}
.hero-photo-wrap::before{content:'PLANTA — ESC 1:100';position:absolute;top:-11px;left:16px;background:#fff;padding:0 8px;font-family:var(--mono);font-size:11px;color:var(--accent)}
.hero-photo-box{height:260px;background:repeating-linear-gradient(45deg,rgba(30,79,216,.05) 0 10px,transparent 10px 20px);border:1px dashed rgba(30,79,216,.4);display:flex;align-items:center;justify-content:center;padding:20px;overflow:hidden}
.hero-photo-box img{width:100%;height:100%;object-fit:cover}

section.blk{padding:80px 0}
.alt-bg{background:var(--white-pure)}
.section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:44px;flex-wrap:wrap;gap:14px}
.section-head.centered{text-align:center;max-width:600px;margin:0 auto 46px;display:block}
.eyebrow-c{font-family:var(--mono);display:inline-block;color:var(--accent);font-weight:700;font-size:12px;letter-spacing:.06em}
.section-head h2{font-size:30px}
.section-head p{color:var(--ink-soft);font-size:15px;margin-top:8px}

.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media(max-width:860px){.grid-3{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.grid-3{grid-template-columns:1fr}}
.card{border:1px solid var(--line);border-radius:2px;overflow:hidden}
.card .ph{height:190px;background:repeating-linear-gradient(45deg,#EEF1F7 0 10px,#fff 10px 20px);display:flex;align-items:center;justify-content:center;color:var(--accent);font-family:var(--mono);font-size:13px}
.card .ph img{width:100%;height:100%;object-fit:cover}
.card-body{padding:20px}
.card .idx{font-family:var(--mono);color:var(--accent);font-size:12px;margin-bottom:6px;display:block}
.card h3{font-size:17px;margin-bottom:6px}
.card p{color:var(--ink-soft);font-size:13.5px}

.team{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line);border-radius:2px}
@media(max-width:760px){.team{grid-template-columns:1fr 1fr}}
.member{text-align:center;padding:24px 14px;border-right:1px solid var(--line)}
.member .ph{width:56px;height:56px;border-radius:2px;margin:0 auto 12px;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-weight:700;font-size:15px}
.member .name{font-weight:600;font-size:14px}
.member .rol{color:var(--ink-soft);font-size:12px;margin-top:2px}
.member .cred{color:var(--ink-soft);font-size:11px;margin-top:5px;opacity:.75}

.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media(max-width:860px){.steps{grid-template-columns:1fr}}
.step{border:1px solid var(--line);border-radius:2px;padding:24px}
.step .num{font-family:var(--mono);font-size:26px;font-weight:700;color:var(--accent);margin-bottom:12px;display:block}
.step h3{font-size:16px;margin-bottom:8px}
.step p{color:var(--ink-soft);font-size:14px}

.consulta{background:var(--white-pure);border:1px solid var(--line);border-radius:2px;padding:3rem}
@media(max-width:640px){.consulta{padding:2rem 1.4rem}}
.consulta-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.6rem;align-items:start;margin-top:2rem}
@media(max-width:860px){.consulta-grid{grid-template-columns:1fr}}
.consulta-points{display:flex;flex-direction:column;gap:1.2rem}
.cpoint{display:flex;gap:14px}
.cpoint .ic{font-family:var(--mono);width:34px;height:34px;background:var(--ink);color:#fff;flex:none;display:flex;align-items:center;justify-content:center;font-weight:700;border-radius:2px}
.cpoint h4{font-size:15px;font-weight:600}
.cpoint p{font-size:13.5px;color:var(--ink-soft);margin-top:3px}
.form-card{background:#fff;border:1px solid var(--line);border-radius:2px;padding:1.8rem}
.form-card label{font-weight:600;color:var(--ink);font-size:13px;display:block;margin-bottom:6px}
.field{margin-bottom:14px}
.field input,.field select,.field textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:2px;font-size:14.5px;font-family:var(--sans);outline:none;background:var(--white-pure);color:var(--ink)}
.field textarea{resize:vertical;min-height:80px}
.form-note{font-size:12px;color:var(--ink-soft);margin-top:10px;line-height:1.5}

.testis{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
@media(max-width:760px){.testis{grid-template-columns:1fr}}
.testi{background:#fff;border:1px solid var(--line);border-radius:2px;padding:1.6rem}
.testi p{font-size:14px;color:var(--ink);font-style:italic}
.testi .who{margin-top:12px;font-weight:700;font-size:12.5px}
.testi .who span{display:block;font-weight:500;color:var(--ink-soft);font-size:11.5px;margin-top:1px}

.faq-item{border-bottom:1px solid var(--line);padding:20px 0}
.faq-item summary{font-weight:600;font-size:15px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:'+';font-size:20px;color:var(--accent);flex:none}
.faq-item[open] summary::after{content:'−'}
.faq-item p{color:var(--ink-soft);font-size:14px;margin-top:10px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1rem}
.citem{display:flex;gap:14px;align-items:flex-start}
.citem .ic{font-family:var(--mono);width:32px;height:32px;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;flex:none;font-weight:700;font-size:13px;border-radius:2px}
.citem h4{font-size:14px;font-weight:600}
.citem p{font-size:13.5px;color:var(--ink-soft)}
.map-embed{border:1px solid var(--line);border-radius:2px;aspect-ratio:4/3}
.map-embed iframe{width:100%;height:100%;border:0}

.cta-final{background:var(--ink);border-radius:2px;text-align:center;padding:64px 40px;margin:0 24px}
.cta-final h2{color:#fff;font-size:30px;margin-bottom:14px}
.cta-final p{color:#B7BCC6;margin-bottom:26px}

footer{padding:34px 0;color:var(--ink-soft);font-size:13px;border-top:1px solid var(--line)}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:22px;flex-wrap:wrap}
.foot-links a:hover{color:var(--accent)}
.legal-note{max-width:760px;margin:16px auto 0;text-align:center;font-size:11.5px;color:#9AA1A6;line-height:1.6}

.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.25);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:12px;color:var(--ink);border:1px solid var(--line)}
.cta-bar .btn-primary{color:#fff;border-color:var(--accent);background:var(--accent)}
@media(max-width:600px){.cta-bar{display:flex}}
.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--ink);color:#fff;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;opacity:.85;z-index:61;font-family:var(--mono)}
@media(max-width:600px){.tpl-badge{bottom:78px}}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <div class="logo">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{nombre_negocio}}</div>
    <nav><ul>
      <li><a href="areas.html">Servicios</a></li>
      <li><a href="equipo.html">Estudio</a></li>
      {{#hay_casos}}<li><a href="#casos">Proyectos</a></li>{{/hay_casos}}
      <li><a href="contacto.html">Contacto</a></li>
    </ul></nav>
    <a class="btn btn-primary" href="#consulta">Empezar un proyecto</a>
  </div>
</header>

<section class="hero"><div class="wrap hero-inner">
  <div>
    <span class="eyebrow">{{eyebrow_hero}}</span>
    <h1>{{hero_title}}</h1>
    <p>{{hero_subtitle}}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#casos">Ver proyectos</a>
      <a class="btn btn-ghost" href="#consulta">Cómo trabajamos</a>
    </div>
    <div class="trust">{{#trust_badges}}<span>{{.}}</span> {{/trust_badges}}</div>
  </div>
  <div class="hero-photo-wrap"><div class="hero-photo-box">{{#foto_hero_url}}<img src="{{foto_hero_url}}" alt="{{nombre_negocio}}">{{/foto_hero_url}}{{^foto_hero_url}}Foto del proyecto{{/foto_hero_url}}</div></div>
</div></section>

<section class="blk" id="areas"><div class="wrap">
  <div class="section-head"><div><div class="eyebrow-c">// SERVICIOS</div><h2>{{h2_areas}}</h2></div></div>
  <p style="color:var(--ink-soft);font-size:15px;margin:-30px 0 30px;max-width:600px">{{lead_areas}}</p>
  <div class="grid-3">{{#areas}}<div class="card"><div class="ph">{{titulo}}</div><div class="card-body"><h3>{{titulo}}</h3><p>{{descripcion}}</p></div></div>{{/areas}}</div>
</div></section>

<section class="blk alt-bg" id="equipo"><div class="wrap">
  <div class="section-head"><div><div class="eyebrow-c">// ESTUDIO</div><h2>Quién firma el proyecto</h2></div></div>
  <div class="team">{{#equipo}}<div class="member">{{#foto_url}}<img class="ph" src="{{foto_url}}" alt="{{nombre}}">{{/foto_url}}{{^foto_url}}<div class="ph">{{inicial_negocio}}</div>{{/foto_url}}<div class="name">{{nombre}}</div><div class="rol">{{rol}}</div><p class="cred">{{credencial}}</p></div>{{/equipo}}</div>
</div></section>

{{#hay_casos}}
<section class="blk" id="casos"><div class="wrap">
  <div class="section-head"><div><div class="eyebrow-c">// PROYECTOS</div><h2>{{h2_casos}}</h2></div></div>
  <p style="color:var(--ink-soft);font-size:15px;margin:-30px 0 30px;max-width:600px">{{lead_casos}}</p>
  <div class="grid-3">{{#casos}}<div class="card">{{#foto_url}}<div class="ph"><img src="{{foto_url}}" alt="{{titulo}}"></div>{{/foto_url}}{{^foto_url}}<div class="ph">Foto / imagen</div>{{/foto_url}}<div class="card-body"><h3>{{titulo}}</h3><p>{{descripcion}}</p></div></div>{{/casos}}</div>
</div></section>
{{/hay_casos}}

<section class="blk alt-bg" id="consulta"><div class="wrap">
  <div class="consulta">
    <div class="section-head centered"><div class="eyebrow-c">// PROCESO</div><h2>{{h2_consulta}}</h2><p>{{lead_consulta}}</p></div>
    <div class="consulta-grid">
      <div class="consulta-points">{{#consulta_points}}<div class="cpoint"><div class="ic">{{n}}</div><div><h4>{{titulo}}</h4><p>{{descripcion}}</p></div></div>{{/consulta_points}}</div>
      <div class="form-card">
        <div class="field"><label>Tipo de proyecto</label><select name="area">{{#areas}}<option>{{titulo}}</option>{{/areas}}<option>Aún no lo sé</option></select></div>
        <div class="field"><label>Nombre</label><input type="text" placeholder="Tu nombre"></div>
        <div class="field"><label>Teléfono o email</label><input type="text" placeholder="Cómo te contactamos"></div>
        <div class="field"><label>Cuéntanos tu proyecto</label><textarea placeholder="Escribe aquí..."></textarea></div>
        <a href="https://wa.me/{{telefono_wa}}" class="btn btn-primary" style="width:100%;display:block">Pedir primera visita</a>
        <p class="form-note">Al enviar este formulario aceptas nuestra política de privacidad. Tus datos se tratan conforme al RGPD y no se ceden a terceros.</p>
      </div>
    </div>
  </div>
</div></section>

{{#hay_testimonios}}
<section class="blk"><div class="wrap">
  <div class="section-head centered"><div class="eyebrow-c">// OPINIONES</div><h2>Lo que dicen nuestros clientes</h2></div>
  <div class="testis">{{#testimonios}}<div class="testi"><p>&quot;{{cita}}&quot;</p><div class="who">{{nombre}}<span>{{contexto}}</span></div></div>{{/testimonios}}</div>
</div></section>
{{/hay_testimonios}}

{{#hay_faqs}}
<section class="blk alt-bg" id="faq"><div class="wrap" style="max-width:760px">
  <div class="section-head centered"><div class="eyebrow-c">// FAQ</div><h2>Antes de que preguntes</h2></div>
  {{#faqs}}<details class="faq-item"><summary>{{pregunta}}</summary><p>{{respuesta}}</p></details>{{/faqs}}
</div></section>
{{/hay_faqs}}

<section class="blk" id="contacto"><div class="wrap">
  <div class="section-head"><div><div class="eyebrow-c">// CONTACTO</div><h2>Visítanos o escríbenos</h2></div></div>
  <div class="contact-grid" style="margin-top:1rem">
    <div class="contact-list">
      <div class="citem"><div class="ic">📍</div><div><h4>Ciudad</h4><p>{{ciudad}}</p></div></div>
      <div class="citem"><div class="ic">☎</div><div><h4>Teléfono</h4><p>{{telefono}}</p></div></div>
      <div class="citem"><div class="ic">✉</div><div><h4>Email</h4><p>{{email}}</p></div></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-ghost" style="margin-top:6px;width:fit-content">Escribir por WhatsApp</a>
    </div>
    <div class="map-embed"><iframe src="https://www.google.com/maps?q={{ciudad_url}},Spain&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section class="blk">
  <div class="cta-final">
    <h2>¿Hablamos de tu proyecto?</h2>
    <p>Cuéntanos tu idea y te decimos, sin compromiso, cómo la abordaríamos.</p>
    <a class="btn btn-primary" href="https://wa.me/{{telefono_wa}}">Pedir primera visita</a>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Estudio de arquitectura</div>
      <div class="foot-links"><a href="aviso-legal.html">Aviso legal</a><a href="privacidad.html">Política de privacidad</a><a href="cookies.html">Cookies</a></div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar"><a href="tel:{{telefono}}" class="btn">Llamar</a><a href="#consulta" class="btn btn-primary">Consulta</a></div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.485 1.34 5.003l-1.42 5.183 5.309-1.394a9.96 9.96 0 0 0 4.768 1.214h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.935 9.935 0 0 0-7.072-2.937zm5.878 15.845a8.257 8.257 0 0 1-4.879 1.535h-.003a8.276 8.276 0 0 1-4.217-1.155l-.303-.18-3.15.827.84-3.07-.198-.315a8.234 8.234 0 0 1-1.264-4.398c0-4.564 3.713-8.277 8.28-8.277a8.226 8.226 0 0 1 5.856 2.428 8.222 8.222 0 0 1 2.42 5.857c0 4.564-3.713 8.276-8.28 8.276z"/></svg>
</a>

</body>
</html>
