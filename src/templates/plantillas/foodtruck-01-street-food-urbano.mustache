<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<title>{{nombre_negocio}} — Hostelería</title>
<meta name="description" content="{{hero_subtitle}}">
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · HOSTELERÍA · Food truck
   Diseño 1: Street food urbano (tema oscuro)
   ═══════════════════════════════════════ */
:root{
  --accent:#F5D821; --accent-mid:#D9BE12; --accent-dim:rgba(245,216,33,.14);
  --ink:#fff; --ink-soft:#A0A0A0; --cream:#0A0A0A; --white-pure:#171717; --line:#2A2A2A;
  --serif:'Anton',sans-serif; --sans:'Inter',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);color:var(--ink);line-height:1.6;background:var(--cream)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:400;text-transform:uppercase}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
header{padding:22px 0;border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:var(--serif);font-size:22px;display:flex;align-items:center;gap:9px}
.logo img{height:32px;width:auto;display:block}
.logo .mark{width:30px;height:30px;background:var(--accent);color:#0A0A0A;display:flex;align-items:center;justify-content:center;font-size:14px;font-family:var(--serif)}
.logo span{color:var(--accent)}
nav ul{list-style:none;display:flex;gap:26px;font-size:12.5px;text-transform:uppercase}
nav ul a{color:var(--ink-soft);text-decoration:none}
nav ul a:hover{color:var(--accent)}
.btn{display:inline-block;padding:13px 26px;font-size:12.5px;font-weight:700;text-decoration:none;text-transform:uppercase;border:none;cursor:pointer;border-radius:2px;text-align:center}
.btn-primary{background:var(--accent);color:#0A0A0A}
.btn-primary:hover{background:var(--accent-mid)}
.btn-ghost{color:#fff;border:1px solid var(--line)}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
@media(max-width:760px){nav ul{display:none}}

.hero{padding:60px 0 84px}
.hero-inner{display:grid;grid-template-columns:1.1fr .9fr;gap:46px;align-items:center}
@media(max-width:860px){.hero-inner{grid-template-columns:1fr}}
.hero .eyebrow{color:var(--accent);font-size:12.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:16px;display:block}
.hero h1{font-size:50px;line-height:1;margin-bottom:20px}
.hero p{color:var(--ink-soft);font-size:14.5px;max-width:380px;margin-bottom:24px;text-transform:none}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
.hero-photo{background:var(--white-pure);border:1px solid var(--line);border-radius:4px;object-fit:cover;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-family:var(--serif);font-size:14px;text-align:center;padding:20px;text-transform:uppercase}
@media(max-width:860px){.hero h1{font-size:36px}}

.trust{display:flex;flex-wrap:wrap;gap:16px 28px;margin-top:24px;color:var(--ink-soft);font-weight:500;font-size:12px;text-transform:uppercase;letter-spacing:.03em}
.trust span{display:flex;align-items:center;gap:8px}
.trust span::before{content:'';width:5px;height:5px;background:var(--accent);flex:none}

section{padding:58px 0}
.alt-bg{background:var(--white-pure)}
.section-head{margin-bottom:32px;max-width:540px}
.eyebrow-c{display:block;color:var(--accent);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:10px}
.section-head h2{font-size:26px}
.section-head p{color:var(--ink-soft);font-size:14px;margin-top:10px;text-transform:none}

.menu-cats{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:var(--line);margin-top:2.4rem}
@media(max-width:860px){.menu-cats{grid-template-columns:1fr}}
.menu-cat{background:var(--cream);padding:26px 22px}
.menu-cat h3{font-size:17px;color:var(--accent);margin-bottom:14px}
.dish{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px dashed var(--line)}
.dish:last-child{border-bottom:none}
.dish .name{font-weight:500;font-size:14px;text-transform:none}
.dish .desc{color:var(--ink-soft);font-size:12.5px;margin-top:2px;text-transform:none}
.dish .price{font-family:var(--serif);font-weight:700;color:var(--accent);white-space:nowrap}

.story-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:3rem;align-items:center;margin-top:2.4rem}
@media(max-width:860px){.story-grid{grid-template-columns:1fr}}
.story-photo{object-fit:cover;aspect-ratio:4/3;background:var(--white-pure);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-family:var(--serif);font-size:13px;text-transform:uppercase}
.story-p{color:var(--ink-soft);font-size:14px;margin-bottom:14px;text-transform:none}

.events{display:flex;flex-direction:column;gap:1px;background:var(--line);margin-top:2.4rem}
.event{background:var(--cream);display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.4rem;gap:14px;flex-wrap:wrap}
.event .date{font-family:var(--serif);font-weight:700;color:var(--accent);min-width:90px}
.event .what{font-weight:500;font-size:14px;text-transform:none}
.event .desc{color:var(--ink-soft);font-size:13px;text-transform:none}

.reservas{background:var(--accent)}
.res-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem;margin-top:2.4rem;align-items:stretch}
@media(max-width:860px){.res-grid{grid-template-columns:1fr}}
.res-card{background:rgba(0,0,0,.08);padding:1.7rem}
.res-card h3{color:#0A0A0A;font-size:17px;margin-bottom:8px}
.res-card p{color:#2A2A2A;font-size:13.5px;margin-bottom:16px;text-transform:none}
.reservas .section-head h2,.reservas .eyebrow-c{color:#0A0A0A}
.reservas .section-head p{color:#2A2A2A}

.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:var(--line);margin-top:2.4rem}
@media(max-width:760px){.gallery{grid-template-columns:repeat(2,1fr)}}
.gph{object-fit:cover;aspect-ratio:1/1;background:var(--cream);display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-size:12px;text-transform:none}

.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:var(--line);margin-top:2.4rem}
@media(max-width:760px){.reviews{grid-template-columns:1fr}}
.review{background:var(--white-pure);padding:1.5rem}
.review .stars{color:var(--accent);font-size:14px;margin-bottom:10px}
.review p{font-size:14px;color:var(--ink-soft);font-style:italic;text-transform:none}
.review .who{margin-top:14px;font-weight:600;font-size:13px;text-transform:uppercase}

.faq{margin-top:0;max-width:700px}
.faq details{border-bottom:1px solid var(--line);padding:16px 0}
.faq summary{font-family:var(--sans);font-size:14px;font-weight:700;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;text-transform:none}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';font-size:20px;color:var(--accent);flex:none;transition:.2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{color:var(--ink-soft);font-size:13px;margin-top:8px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem;margin-top:2.4rem;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1.1rem}
.citem{display:flex;gap:14px;align-items:flex-start}
.citem .ic{width:32px;height:32px;background:var(--accent-dim);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none;font-weight:700;font-size:13px}
.citem h4{font-size:14px}
.citem p{font-size:13.5px;color:var(--ink-soft);text-transform:none}
.map-embed{overflow:hidden;border:1px solid var(--line);aspect-ratio:4/3;filter:grayscale(1) invert(.9) contrast(1.1)}
.map-embed iframe{width:100%;height:100%;border:0}

.cta-final{text-align:center;padding:56px 36px;background:var(--accent)}
.cta-final h2{color:#0A0A0A;font-size:30px;margin-bottom:12px}
.cta-final p{color:#2A2A2A;margin-bottom:20px;text-transform:none}

footer{padding:24px 0;color:var(--ink-soft);font-size:12px;border-top:1px solid var(--line);text-transform:none}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:20px;flex-wrap:wrap}
.foot-links a:hover{color:var(--accent)}
.legal-note{max-width:760px;margin:16px auto 0;text-align:center;font-size:11px;color:#555;line-height:1.6}

.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.4);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(10,10,10,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:11px}
@media(max-width:600px){.cta-bar{display:flex}}
.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--accent);color:#0A0A0A;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;border-radius:100px;opacity:.9;z-index:61;font-family:var(--sans);text-transform:none}
@media(max-width:600px){.tpl-badge{bottom:78px}}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <div class="logo">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{^logo_url}}<span class="mark">{{inicial_negocio}}</span> {{nombre_negocio}}{{/logo_url}}</div>
    <nav><ul>
      <li><a href="carta.html">Menú</a></li>
      <li><a href="nosotros.html">Nosotros</a></li>
      {{#hay_events}}<li><a href="#eventos">Dónde estamos</a></li>{{/hay_events}}
      <li><a href="contacto.html">Contacto</a></li>
    </ul></nav>
    <a class="btn btn-primary" href="#reservas">Encuéntranos</a>
  </div>
</header>

<section class="hero">
  <div class="wrap hero-inner">
    <div>
      <span class="eyebrow">{{eyebrow_hero}}</span>
      <h1>{{hero_title}}</h1>
      <p>{{hero_subtitle}}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#reservas">Encuéntranos</a>
        <a class="btn btn-ghost" href="#carta">Ver menú</a>
      </div>
      <div class="trust">{{#trust_badges}}<span>{{.}}</span>{{/trust_badges}}</div>
    </div>
    {{#foto_hero_url}}<img class="hero-photo" src="{{foto_hero_url}}" alt="{{nombre_negocio}}">{{/foto_hero_url}}{{^foto_hero_url}}<div class="hero-photo">Foto de la food truck</div>{{/foto_hero_url}}
  </div>
</section>

<section id="carta"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Menú</span><h2>Lo que servimos</h2><p>{{lead_carta}}</p></div>
  {{#preview}}
  <div style="display:flex;gap:10px;margin-bottom:1.6rem;flex-wrap:wrap">
    <span style="padding:8px 16px;font-size:12px;font-weight:600;background:var(--accent);color:#0A0A0A">Menú</span>
    <span style="padding:8px 16px;font-size:12px;font-weight:600;color:var(--ink-soft);border:1px solid var(--line)">+ Página de catering para eventos — suplemento</span>
  </div>
  {{/preview}}
  <div class="menu-cats">{{#menu_cats}}<div class="menu-cat"><h3>{{categoria}}</h3>{{#platos}}<div class="dish"><div><div class="name">{{nombre}}</div>{{#descripcion}}<div class="desc">{{descripcion}}</div>{{/descripcion}}</div><div class="price">{{precio}}</div></div>{{/platos}}</div>{{/menu_cats}}</div>
</div></section>

<section class="alt-bg" id="nosotros"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Nosotros</span><h2>Nuestra historia</h2></div>
  <div class="story-grid">
    {{#foto_secundaria_url}}<img class="story-photo" src="{{foto_secundaria_url}}" alt="{{nombre_negocio}}">{{/foto_secundaria_url}}{{^foto_secundaria_url}}<div class="story-photo">Foto del equipo</div>{{/foto_secundaria_url}}
    <div><p class="story-p">{{historia_p1}}</p><p class="story-p">{{historia_p2}}</p></div>
  </div>
</div></section>

{{#hay_events}}
<section id="eventos"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Ruta</span><h2>Dónde estaremos</h2></div>
  <div class="events">{{#events}}<div class="event"><div class="date">{{fecha}}</div><div class="what">{{what}}</div><div class="desc">{{desc}}</div></div>{{/events}}</div>
</div></section>
{{/hay_events}}

<section class="reservas" id="reservas"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Ubicación</span><h2>Síguenos allá donde vamos</h2><p>La forma más rápida es escribirnos por WhatsApp.</p></div>
  <div class="res-grid">
    <div class="res-card"><h3>Encuéntranos hoy</h3><p>{{res_directa_texto}}</p><a href="https://wa.me/{{telefono_wa}}" class="btn btn-primary" style="background:#0A0A0A;color:#fff">Escribir por WhatsApp</a></div>
    <div class="res-card"><h3>Eventos privados</h3><p>También disponibles para bodas, festivales y eventos de empresa.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap"><a href="tel:{{telefono}}" class="btn btn-ghost" style="background:transparent;color:#0A0A0A;border-color:rgba(0,0,0,.3)">Llamar</a></div>
      {{#preview}}<p style="margin-top:14px;font-size:11.5px;color:#3A3A3A">Función ampliable: mapa en directo con la ubicación actualizada del food truck.</p>{{/preview}}
    </div>
  </div>
</div></section>

<section class="alt-bg"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Galería</span><h2>La furgo y los platos</h2></div>
  <div class="gallery">{{#galeria}}<img class="gph" src="{{url}}">{{/galeria}}{{^galeria}}<div class="gph">Foto</div><div class="gph">Foto</div><div class="gph">Foto</div><div class="gph">Foto</div>{{/galeria}}</div>
</div></section>

{{#hay_reviews}}
<section><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Opiniones</span><h2>Lo que dicen los clientes</h2></div>
  <div class="reviews">{{#reviews}}<div class="review"><div class="stars">★★★★★</div><p>&quot;{{cita}}&quot;</p><div class="who">{{nombre}}</div></div>{{/reviews}}</div>
</div></section>
{{/hay_reviews}}

{{#hay_faqs}}
<section class="alt-bg" id="faq"><div class="wrap" style="max-width:700px">
  <div class="section-head"><span class="eyebrow-c">Preguntas frecuentes</span><h2>Lo que preguntan</h2></div>
  <div class="faq">{{#faqs}}<details><summary>{{pregunta}}</summary><p>{{respuesta}}</p></details>{{/faqs}}</div>
</div></section>
{{/hay_faqs}}

<section id="contacto"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Contacto</span><h2>Escríbenos</h2></div>
  <div class="contact-grid">
    <div class="contact-list">
      <div class="citem"><div class="ic">📍</div><div><h4>Ciudad</h4><p>{{ciudad}}</p></div></div>
      <div class="citem"><div class="ic">☎</div><div><h4>Teléfono</h4><p>{{telefono}}</p></div></div>
      <div class="citem"><div class="ic">✉</div><div><h4>Email</h4><p>{{email}}</p></div></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-ghost" style="margin-top:6px;width:fit-content">Escribir por WhatsApp</a>
    </div>
    <div class="map-embed"><iframe src="https://www.google.com/maps?q={{ciudad_url}},Spain&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section><div class="wrap">
  <div class="cta-final">
    <h2>¿Nos buscas hoy?</h2>
    <p>Sigue nuestra ubicación en redes.</p>
    <a class="btn btn-ghost" href="#reservas" style="background:#0A0A0A;color:#fff;border-color:#0A0A0A">Encuéntranos</a>
  </div>
</div></section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Hostelería</div>
      <div class="foot-links"><a href="aviso-legal.html">Aviso legal</a><a href="privacidad.html">Política de privacidad</a><a href="cookies.html">Cookies</a></div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar"><a href="tel:{{telefono}}" class="btn btn-ghost">Llamar</a><a href="#reservas" class="btn btn-primary">Encuéntranos</a></div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.485 1.34 5.003l-1.42 5.183 5.309-1.394a9.96 9.96 0 0 0 4.768 1.214h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.935 9.935 0 0 0-7.072-2.937zm5.878 15.845a8.257 8.257 0 0 1-4.879 1.535h-.003a8.276 8.276 0 0 1-4.217-1.155l-.303-.18-3.15.827.84-3.07-.198-.315a8.234 8.234 0 0 1-1.264-4.398c0-4.564 3.713-8.277 8.28-8.277a8.226 8.226 0 0 1 5.856 2.428 8.222 8.222 0 0 1 2.42 5.857c0 4.564-3.713 8.276-8.28 8.276z"/></svg>
</a>

</body>
</html>
