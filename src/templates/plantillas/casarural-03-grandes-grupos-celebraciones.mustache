<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#C1633B">
<title>{{nombre_negocio}} — Alojamiento</title>
<meta name="description" content="{{hero_subtitle}}">
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · TURISMO Y ALOJAMIENTO · Casa rural
   Diseño 3: Grandes grupos y celebraciones
   ═══════════════════════════════════════ */
:root{
  --accent:#C1633B; --accent-mid:#A34F2C; --accent-dim:#F3E0D2;
  --ink:#2E2210; --ink-soft:#7A6A4E; --cream:#FFF9EC; --white-pure:#FFFFFF; --line:#F0D9AD;
  --green:#3D9455;
  --serif:'Baloo 2',sans-serif; --sans:'Nunito',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);color:var(--ink);line-height:1.65;background:var(--cream)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:600}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
header{padding:24px 0}
.nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:var(--serif);font-weight:600;font-size:21px;color:var(--ink);display:flex;align-items:center;gap:9px}
.logo img{height:32px;width:auto;display:block}
.logo .mark{width:30px;height:30px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700}
nav ul{list-style:none;display:flex;gap:28px;font-size:13.5px}
nav ul a{color:var(--ink);text-decoration:none}
nav ul a:hover{color:var(--accent)}
.btn{display:inline-block;padding:13px 28px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;border:none;cursor:pointer;text-align:center}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent-mid)}
.btn-ghost{color:var(--ink);border:1.5px solid var(--line);background:transparent}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
@media(max-width:760px){nav ul{display:none}}

.hero{padding:20px 0 20px;text-align:center}
.hero-inner{max-width:680px;margin:0 auto}
.hero .eyebrow{display:block;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
.hero h1{font-size:40px;line-height:1.2;margin-bottom:16px}
.hero p{color:var(--ink-soft);font-size:15.5px;margin-bottom:26px;max-width:520px;margin-left:auto;margin-right:auto}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
.hero-photo{max-width:640px;margin:28px auto 0;background:var(--green);border-radius:16px;object-fit:cover;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.7);font-family:var(--serif);font-size:14px}

.trust{display:flex;flex-wrap:wrap;gap:16px 30px;margin-top:22px;color:var(--ink-soft);font-weight:700;font-size:13.5px;justify-content:center}
.trust span{display:flex;align-items:center;gap:8px}
.trust span::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex:none}

section.blk{padding:66px 0}
.alt{background:#FCEEDA}
.section-head{text-align:center;max-width:600px;margin:0 auto 40px}
.eyebrow-c{display:block;color:var(--accent);font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin-bottom:12px}
.section-head h2{font-size:30px}
.section-head p{color:var(--ink-soft);font-size:14.5px;margin-top:10px}

.units{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
@media(max-width:860px){.units{grid-template-columns:1fr}}
.unit{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden}
.unit .ph{object-fit:cover;aspect-ratio:16/10;background:var(--green);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.6);font-family:var(--serif);font-size:13px}
.unit-body{padding:20px}
.unit-body h3{font-size:17px;margin-bottom:8px}
.unit-body p{font-size:13.5px;color:var(--ink-soft);margin-bottom:12px}
.unit-body .price{font-weight:700;color:var(--accent);font-size:14px}

.amen{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
@media(max-width:760px){.amen{grid-template-columns:repeat(2,1fr)}}
.badge{padding:26px 20px;text-align:center;border-right:1px solid var(--line)}
.badge:last-child{border-right:none}

.amen2{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 30px;max-width:760px;margin:0 auto}
@media(max-width:560px){.amen2{grid-template-columns:1fr}}
.amen2 span{font-size:14px;display:flex;align-items:center;gap:10px;font-weight:700}
.amen2 span::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none}

.env{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
@media(max-width:860px){.env{grid-template-columns:1fr}}
.env-item{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1.5rem}
.env-item .n{font-family:var(--serif);font-size:15px;color:var(--accent);display:block;margin-bottom:8px}
.env-item h3{font-size:16.5px;margin-bottom:8px}
.env-item p{color:var(--ink-soft);font-size:13.5px}

.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
@media(max-width:760px){.gallery{grid-template-columns:repeat(2,1fr)}}
.gph{object-fit:cover;aspect-ratio:1/1;background:var(--green);border-radius:12px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.6);font-size:12px}

.reserva{background:var(--ink);color:#fff}
.reserva h2{color:#fff}
.reserva .lead{color:rgba(255,255,255,.68)}
.reserva-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
@media(max-width:860px){.reserva-grid{grid-template-columns:1fr}}
.reserva-points{display:flex;flex-direction:column;gap:1.3rem}
.rpoint{display:flex;gap:14px}
.rpoint .ic{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.1);flex:none;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}
.rpoint h4{font-size:15px;color:#fff}
.rpoint p{font-size:13.5px;color:rgba(255,255,255,.62);margin-top:3px}
.form-card{background:#fff;border-radius:16px;padding:1.8rem}
.form-card label{font-weight:700;color:var(--ink);font-size:13.5px;display:block;margin-bottom:6px}
.field{margin-bottom:14px}
.field2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.field input,.field select{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:8px;font-size:14.5px;font-family:var(--sans);outline:none;background:var(--cream);color:var(--ink)}
.form-note{font-size:12px;color:var(--ink-soft);margin-top:10px;line-height:1.5}

.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
@media(max-width:760px){.reviews{grid-template-columns:1fr}}
.review{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1.6rem}
.review .stars{color:var(--accent);font-size:14px;margin-bottom:10px}
.review p{font-size:14px;color:var(--ink);font-style:italic}
.review .who{margin-top:14px;font-weight:700;font-size:13px;color:var(--ink-soft)}

.faq{max-width:700px;margin:0 auto}
.faq details{border-bottom:1px solid var(--line);padding:18px 0}
.faq summary{font-weight:700;font-size:15px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';font-size:20px;color:var(--accent);flex:none;transition:.2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{color:var(--ink-soft);font-size:13.5px;margin-top:8px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1.1rem}
.citem{display:flex;gap:14px;align-items:flex-start}
.citem .ic{width:36px;height:36px;border-radius:50%;background:var(--accent-dim);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none;font-weight:700;font-size:14px}
.citem h4{font-size:14.5px;font-weight:700}
.citem p{font-size:13.5px;color:var(--ink-soft)}
.map-embed{border-radius:14px;overflow:hidden;aspect-ratio:4/3;border:1px solid var(--line)}
.map-embed iframe{width:100%;height:100%;border:0}

.cta-final{text-align:center;padding:64px 40px;background:var(--accent);color:#fff;border-radius:20px}
.cta-final h2{color:#fff;font-size:28px;margin-bottom:14px}
.cta-final p{opacity:.9;margin-bottom:22px}

footer{padding:32px 0;color:var(--ink-soft);font-size:12.5px;border-top:1px solid var(--line)}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:22px;flex-wrap:wrap}
.foot-links a:hover{color:var(--accent)}
.legal-note{max-width:760px;margin:16px auto 0;text-align:center;font-size:11.5px;color:#B3A47A;line-height:1.6}

.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.2);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(255,249,236,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:12px}
@media(max-width:600px){.cta-bar{display:flex}}
.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--ink);color:#fff;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;border-radius:100px;opacity:.85;z-index:61}
@media(max-width:600px){.tpl-badge{bottom:78px}}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <div class="logo">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{^logo_url}}<span class="mark">{{inicial_negocio}}</span> {{nombre_negocio}}{{/logo_url}}</div>
    <nav><ul>
      <li><a href="alojamiento.html">Alojamientos</a></li>
      <li><a href="#servicios">Experiencia</a></li>
      <li><a href="entorno.html">Entorno</a></li>
      <li><a href="contacto.html">Contacto</a></li>
    </ul></nav>
    <a class="btn btn-primary" href="#reserva">Reservar</a>
  </div>
</header>

<section class="hero">
  <div class="wrap hero-inner">
    <span class="eyebrow">{{eyebrow_hero}}</span>
    <h1>{{hero_title}}</h1>
    <p>{{hero_subtitle}}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#reserva">Consultar disponibilidad</a>
      <a class="btn btn-ghost" href="#alojamiento">Ver espacios</a>
    </div>
    <div class="trust">{{#trust_badges}}<span>{{.}}</span>{{/trust_badges}}</div>
    {{#foto_hero_url}}<img class="hero-photo" src="{{foto_hero_url}}" alt="{{nombre_negocio}}">{{/foto_hero_url}}{{^foto_hero_url}}<div class="hero-photo">Foto de la finca</div>{{/foto_hero_url}}
  </div>
</section>

<section class="blk" id="alojamiento"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Alojamiento</span><h2>{{h2_alojamiento}}</h2><p>{{lead_alojamiento}}</p></div>
  <div class="units">{{#alojamientos}}<div class="unit">{{#foto_url}}<img class="ph" src="{{foto_url}}" alt="{{titulo}}">{{/foto_url}}{{^foto_url}}<div class="ph">Foto de la unidad</div>{{/foto_url}}<div class="unit-body"><h3>{{titulo}}</h3><p>{{capacidad}} · {{descripcion}}</p><span class="price">{{precio_desde}}</span></div></div>{{/alojamientos}}</div>
</div></section>

<section class="blk alt" id="servicios"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Servicios y comodidades</span><h2>{{h2_servicios}}</h2><p>{{lead_servicios}}</p></div>
  <div class="amen2">{{#comodidades}}<span>{{.}}</span>{{/comodidades}}</div>
</div></section>

<section class="blk" id="entorno"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">El entorno</span><h2>{{h2_entorno}}</h2><p>{{lead_entorno}}</p></div>
  <div class="env">{{#entorno}}<div class="env-item"><span class="n">{{n}}</span><h3>{{titulo}}</h3><p>{{descripcion}}</p></div>{{/entorno}}</div>
</div></section>

<section class="blk alt"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Galería</span><h2>Un vistazo a la finca</h2></div>
  <div class="gallery">{{#galeria}}<img class="gph" src="{{url}}">{{/galeria}}{{^galeria}}<div class="gph">Foto</div><div class="gph">Foto</div><div class="gph">Foto</div><div class="gph">Foto</div>{{/galeria}}</div>
</div></section>

<section class="blk reserva" id="reserva"><div class="wrap">
  <div class="section-head" style="max-width:600px;margin:0 0 2.5rem"><span class="eyebrow-c" style="color:rgba(255,255,255,.6)">Reserva</span><h2>{{h2_reserva}}</h2><p class="lead">{{lead_reserva}}</p></div>
  <div class="reserva-grid">
    <div class="reserva-points">{{#reserva_points}}<div class="rpoint"><div class="ic">{{n}}</div><div><h4>{{titulo}}</h4><p>{{descripcion}}</p></div></div>{{/reserva_points}}</div>
    <div class="form-card">
      <div class="field2"><div class="field"><label>Entrada</label><input type="date"></div><div class="field"><label>Salida</label><input type="date"></div></div>
      <div class="field"><label>Huéspedes</label><select><option>1 persona</option><option>2 personas</option><option>3-4 personas</option><option>5 o más</option></select></div>
      <div class="field"><label>Nombre</label><input type="text" placeholder="Tu nombre"></div>
      <div class="field"><label>Teléfono o email</label><input type="text" placeholder="Cómo te contactamos"></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-primary" style="width:100%">Consultar disponibilidad</a>
      <p class="form-note">Al enviar aceptas nuestra política de privacidad. Tus datos se tratan conforme al RGPD y no se ceden a terceros.{{#preview}} <br>Función ampliable: motor de reservas con disponibilidad y pago online en tiempo real.{{/preview}}</p>
    </div>
  </div>
</div></section>

{{#hay_reviews}}
<section class="blk"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Opiniones</span><h2>Grupos que ya han celebrado con nosotros</h2></div>
  <div class="reviews">{{#reviews}}<div class="review"><div class="stars">★★★★★</div><p>&quot;{{cita}}&quot;</p><div class="who">{{nombre}}</div></div>{{/reviews}}</div>
</div></section>
{{/hay_reviews}}

{{#hay_faqs}}
<section class="blk alt" id="faq"><div class="wrap" style="max-width:700px">
  <div class="section-head"><span class="eyebrow-c">Preguntas frecuentes</span><h2>Antes de reservar</h2></div>
  <div class="faq">{{#faqs}}<details><summary>{{pregunta}}</summary><p>{{respuesta}}</p></details>{{/faqs}}</div>
</div></section>
{{/hay_faqs}}

<section class="blk" id="contacto"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Contacto</span><h2>Dónde estamos y cómo llegar</h2></div>
  <div class="contact-grid">
    <div class="contact-list">
      <div class="citem"><div class="ic">📍</div><div><h4>Ciudad / zona</h4><p>{{ciudad}}</p></div></div>
      <div class="citem"><div class="ic">☎</div><div><h4>Teléfono</h4><p>{{telefono}}</p></div></div>
      <div class="citem"><div class="ic">✉</div><div><h4>Email</h4><p>{{email}}</p></div></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-ghost" style="margin-top:6px;width:fit-content">Escribir por WhatsApp</a>
    </div>
    <div class="map-embed"><iframe src="https://www.google.com/maps?q={{ciudad_url}},Spain&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section class="blk"><div class="wrap">
  <div class="cta-final">
    <h2>Reserva tu celebración</h2>
    <p>Fechas de temporada alta se agotan con meses de antelación.</p>
    <a class="btn btn-ghost" href="#reserva" style="background:#fff;color:var(--accent);border-color:#fff">Reservar ahora</a>
  </div>
</div></section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Alojamiento</div>
      <div class="foot-links"><a href="aviso-legal.html">Aviso legal</a><a href="privacidad.html">Política de privacidad</a><a href="cookies.html">Cookies</a></div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar"><a href="tel:{{telefono}}" class="btn btn-ghost">Llamar</a><a href="#reserva" class="btn btn-primary">Reservar</a></div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.485 1.34 5.003l-1.42 5.183 5.309-1.394a9.96 9.96 0 0 0 4.768 1.214h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.935 9.935 0 0 0-7.072-2.937zm5.878 15.845a8.257 8.257 0 0 1-4.879 1.535h-.003a8.276 8.276 0 0 1-4.217-1.155l-.303-.18-3.15.827.84-3.07-.198-.315a8.234 8.234 0 0 1-1.264-4.398c0-4.564 3.713-8.277 8.28-8.277a8.226 8.226 0 0 1 5.856 2.428 8.222 8.222 0 0 1 2.42 5.857c0 4.564-3.713 8.276-8.28 8.276z"/></svg>
</a>

</body>
</html>
