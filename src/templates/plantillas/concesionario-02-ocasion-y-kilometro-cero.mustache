<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#E8632B">
<title>{{nombre_negocio}} — Automoción</title>
<meta name="description" content="{{hero_subtitle}}">
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · AUTOMOCIÓN · Concesionario
   Diseño 2: Ocasión y kilómetro cero
   Paleta: naranja sobre blanco, look directo y comercial
   ═══════════════════════════════════════ */
:root{
  --accent:#E8632B; --accent-mid:#C94F1E; --accent-dim:rgba(232,99,43,.10);
  --ink:#1B2733; --ink-soft:rgba(27,39,51,.62); --cream:#FFFFFF; --white-pure:#F6F7F9; --line:#E7E9EC;
  --serif:'Archivo',sans-serif; --sans:'Inter',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);color:var(--ink);line-height:1.65;background:var(--cream)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:800}
.wrap{max-width:1140px;margin:0 auto;padding:0 24px}
header{padding:24px 0;box-shadow:0 1px 0 var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:var(--serif);font-weight:800;font-size:21px;color:var(--accent);display:flex;align-items:center;gap:9px}
.logo img{height:34px;width:auto;display:block}
.logo .mark{width:32px;height:32px;border-radius:10px;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px}
nav ul{list-style:none;display:flex;gap:28px;font-size:13.5px}
nav ul a{color:var(--ink);text-decoration:none;font-weight:600}
nav ul a:hover{color:var(--accent)}
.btn{display:inline-block;padding:13px 28px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;border:none;cursor:pointer;text-align:center}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent-mid)}
.btn-ghost{color:var(--ink);border:1px solid var(--line);background:#fff}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
@media(max-width:760px){nav ul{display:none}}

.hero{padding:56px 0 84px}
.hero-inner{display:grid;grid-template-columns:1.05fr .95fr;gap:50px;align-items:center}
@media(max-width:860px){.hero-inner{grid-template-columns:1fr}}
.hero .eyebrow{display:inline-block;background:var(--white-pure);color:var(--accent);font-size:12.5px;font-weight:700;padding:8px 18px;border-radius:100px;margin-bottom:20px}
.hero h1{font-size:38px;line-height:1.18;margin-bottom:18px;color:var(--ink);max-width:14em}
.hero p{color:var(--ink-soft);font-size:15px;max-width:420px;margin-bottom:26px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
.hero-photo{background:var(--white-pure);border-radius:14px;object-fit:cover;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-family:var(--serif);font-size:13.5px;text-align:center;padding:20px}

.trust-bar-sec{padding:0 0 8px}
.trust-bar{display:flex;justify-content:center;gap:14px 34px;flex-wrap:wrap;padding:22px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.trust-item{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700;color:var(--ink-soft)}
.trust-item::before{content:'';width:8px;height:8px;border-radius:2px;background:var(--accent);flex:none}

section{padding:64px 0}
.alt-bg{background:var(--white-pure)}
.section-head{text-align:center;max-width:560px;margin:0 auto 40px}
.eyebrow-c{display:block;color:var(--accent);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:12px;font-weight:800}
.section-head h2{font-size:clamp(1.6rem,3vw,2.1rem)}
.section-head p{color:var(--ink-soft);font-size:15px;margin-top:10px}

.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media(max-width:820px){.grid-3{grid-template-columns:1fr}}
.card{background:#fff;border-radius:14px;padding:28px 24px;border:1px solid var(--line);text-align:center}
.card h3{font-size:17px;margin-bottom:10px;color:var(--ink)}
.card p{color:var(--ink-soft);font-size:13.5px}

.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
@media(max-width:760px){.steps{grid-template-columns:1fr}}
.step{text-align:center}
.step .n{font-family:var(--serif);font-size:32px;color:var(--accent);margin-bottom:10px;display:block}
.step h3{font-size:16px;margin-bottom:8px}
.step p{color:var(--ink-soft);font-size:13.5px}

.reserva{background:var(--ink);color:#fff}
.reserva .section-head p{color:rgba(255,255,255,.68)}
.reserva-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin-top:2rem;align-items:start}
@media(max-width:860px){.reserva-grid{grid-template-columns:1fr}}
.reserva-points{display:flex;flex-direction:column;gap:1.2rem}
.rpoint{display:flex;gap:14px}
.rpoint .ic{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.1);flex:none;display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:800;font-family:var(--serif)}
.rpoint h4{font-size:15px;font-weight:700;color:#fff;font-family:var(--serif)}
.rpoint p{font-size:13.5px;color:rgba(255,255,255,.62);margin-top:3px}
.form-card{background:#fff;border-radius:14px;padding:1.8rem;color:var(--ink)}
.form-card label{font-weight:700;color:var(--ink);font-size:13.5px;display:block;margin-bottom:6px}
.field{margin-bottom:14px}
.field input,.field select,.field textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:9px;font-size:14.5px;font-family:var(--sans);outline:none;background:var(--white-pure);color:var(--ink)}
.field textarea{resize:vertical;min-height:70px}
.form-note{font-size:12px;color:var(--ink-soft);margin-top:10px;line-height:1.5}

.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
@media(max-width:760px){.reviews{grid-template-columns:1fr}}
.review{background:#fff;border-radius:14px;padding:1.5rem;border:1px solid var(--line)}
.review .stars{color:var(--accent);font-size:14px;letter-spacing:2px;margin-bottom:10px}
.review p{font-size:14px;color:var(--ink-soft);font-style:italic}
.review .who{margin-top:14px;font-weight:700;font-size:13px}

.faq{max-width:720px;margin:0 auto}
.faq details{border-bottom:1px solid var(--line);padding:18px 0}
.faq summary{font-family:var(--serif);font-size:15px;font-weight:700;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;color:var(--ink)}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';font-family:var(--sans);font-size:20px;color:var(--accent);flex:none;transition:.2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{color:var(--ink-soft);font-size:13.5px;margin-top:10px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1.1rem}
.citem{display:flex;gap:14px;align-items:flex-start}
.citem .ic{width:34px;height:34px;border-radius:10px;background:var(--accent-dim);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none;font-weight:700;font-size:14px}
.citem h4{font-size:14.5px;font-weight:700;font-family:var(--serif)}
.citem p{font-size:13.5px;color:var(--ink-soft)}
.map-embed{border-radius:14px;overflow:hidden;border:1px solid var(--line);aspect-ratio:4/3}
.map-embed iframe{width:100%;height:100%;border:0}

.cta-final{text-align:center;padding:60px 40px;background:var(--accent);color:#fff;border-radius:18px;margin:0 24px}
.cta-final h2{color:#fff;font-size:28px;margin-bottom:14px}
.cta-final p{color:rgba(255,255,255,.85);margin-bottom:22px}
.cta-final .btn-ghost{background:#fff;color:var(--accent);border-color:#fff}

footer{background:var(--ink);color:rgba(255,255,255,.55);padding:30px 0;font-size:12.5px}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:20px;flex-wrap:wrap}
.foot-links a:hover{color:#fff}
.legal-note{max-width:760px;margin:16px auto 0;text-align:center;font-size:11px;color:rgba(255,255,255,.4);line-height:1.6}

.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.25);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:12px}
@media(max-width:600px){.cta-bar{display:flex}}
.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--ink);color:#fff;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;border-radius:100px;opacity:.85;z-index:61;font-family:var(--sans)}
@media(max-width:600px){.tpl-badge{bottom:78px}}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <div class="logo">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{^logo_url}}<span class="mark">{{inicial_negocio}}</span> {{nombre_negocio}}{{/logo_url}}</div>
    <nav><ul>
      <li><a href="servicios.html">Stock</a></li>
      <li><a href="razones.html">Garantías</a></li>
      <li><a href="contacto.html">Contacto</a></li>
    </ul></nav>
    <a class="btn btn-primary" href="#cita">Ver stock</a>
  </div>
</header>

<section class="hero">
  <div class="wrap hero-inner">
    <div>
      <span class="eyebrow">{{eyebrow_hero}}</span>
      <h1>{{hero_title}}</h1>
      <p>{{hero_subtitle}}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#cita">Ver stock disponible</a>
        <a class="btn btn-ghost" href="tel:{{telefono}}">Llamar ahora</a>
      </div>
    </div>
    {{#foto_hero_url}}<img class="hero-photo" src="{{foto_hero_url}}" alt="{{nombre_negocio}}">{{/foto_hero_url}}{{^foto_hero_url}}<div class="hero-photo">Foto del stock / vehículos</div>{{/foto_hero_url}}
  </div>
</section>

<section class="trust-bar-sec"><div class="wrap"><div class="trust-bar">
  {{#trust_badges}}<div class="trust-item">{{.}}</div>{{/trust_badges}}
</div></div></section>

<section id="servicios"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Stock</span><h2>{{h2_servicios}}</h2><p>{{lead_servicios}}</p></div>
  <div class="grid-3">
    {{#servicios}}<div class="card"><h3>{{titulo}}</h3><p>{{descripcion}}</p></div>{{/servicios}}
  </div>
</div></section>

<section class="alt-bg" id="por-que"><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Garantías</span><h2>{{h2_razones}}</h2><p>{{lead_razones}}</p></div>
  <div class="steps">
    {{#razones}}<div class="step"><span class="n">{{n}}</span><h3>{{titulo}}</h3><p>{{descripcion}}</p></div>{{/razones}}
  </div>
</div></section>

<section class="reserva" id="cita"><div class="wrap">
  <div class="section-head" style="max-width:640px;margin:0 0 2rem"><span class="eyebrow-c" style="color:var(--accent)">Reservar coche</span><h2 style="color:#fff">{{h2_cita}}</h2><p>{{lead_cita}}</p></div>
  <div class="reserva-grid">
    <div class="reserva-points">
      {{#cita_points}}<div class="rpoint"><div class="ic">{{n}}</div><div><h4>{{titulo}}</h4><p>{{descripcion}}</p></div></div>{{/cita_points}}
    </div>
    <div class="form-card">
      <div class="field">
        <label>Modelo de interés</label>
        <select name="modelo">
          {{#servicios}}<option>{{titulo}}</option>{{/servicios}}
          <option>Aún no lo sé, quiero asesoramiento</option>
        </select>
      </div>
      <div class="field"><label>Vehículo de entrega (si tienes)</label><input type="text" placeholder="Marca y modelo, opcional"></div>
      <div class="field"><label>Nombre</label><input type="text" placeholder="Tu nombre"></div>
      <div class="field"><label>Teléfono o email</label><input type="text" placeholder="Cómo te contactamos"></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-primary" style="width:100%">Reservar por WhatsApp</a>
      <p class="form-note">Al enviar aceptas nuestra política de privacidad. Tus datos se tratan conforme al RGPD y no se ceden a terceros.{{#preview}} <br>Función ampliable: financiación simulada online al momento.{{/preview}}</p>
    </div>
  </div>
</div></section>

{{#hay_reviews}}
<section><div class="wrap">
  <div class="section-head"><span class="eyebrow-c">Opiniones</span><h2>Lo que dicen nuestros clientes.</h2></div>
  <div class="reviews">
    {{#reviews}}<div class="review"><div class="stars">★★★★★</div><p>&quot;{{cita}}&quot;</p><div class="who">{{nombre}}</div></div>{{/reviews}}
  </div>
</div></section>
{{/hay_reviews}}

{{#hay_faqs}}
<section class="alt-bg" id="faq"><div class="wrap" style="max-width:720px">
  <div class="section-head"><span class="eyebrow-c">Preguntas frecuentes</span><h2>Antes de comprar de ocasión</h2></div>
  <div class="faq">
    {{#faqs}}<details><summary>{{pregunta}}</summary><p>{{respuesta}}</p></details>{{/faqs}}
  </div>
</div></section>
{{/hay_faqs}}

<section id="contacto"><div class="wrap">
  <div class="section-head" style="margin:0 0 2rem;text-align:left;max-width:none"><span class="eyebrow-c">Contacto</span><h2>Dónde estamos y cómo llegar</h2></div>
  <div class="contact-grid">
    <div class="contact-list">
      <div class="citem"><div class="ic">📍</div><div><h4>Ciudad</h4><p>{{ciudad}}</p></div></div>
      <div class="citem"><div class="ic">☎</div><div><h4>Teléfono</h4><p>{{telefono}}</p></div></div>
      <div class="citem"><div class="ic">✉</div><div><h4>Email</h4><p>{{email}}</p></div></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-ghost" style="margin-top:6px;width:fit-content">Escribir por WhatsApp</a>
    </div>
    <div class="map-embed"><iframe src="https://www.google.com/maps?q={{ciudad_url}},Spain&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section><div class="wrap">
  <div class="cta-final">
    <h2>Encuentra tu coche esta semana</h2>
    <p>Nuevas unidades cada semana, con financiación aprobada al momento.</p>
    <a class="btn btn-ghost" href="#cita">Ver stock disponible</a>
  </div>
</div></section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Automoción</div>
      <div class="foot-links">
        <a href="aviso-legal.html">Aviso legal</a>
        <a href="privacidad.html">Política de privacidad</a>
        <a href="cookies.html">Cookies</a>
      </div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar">
  <a href="tel:{{telefono}}" class="btn btn-ghost">Llamar</a>
  <a href="#cita" class="btn btn-primary">Ver stock</a>
</div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.485 1.34 5.003l-1.42 5.183 5.309-1.394a9.96 9.96 0 0 0 4.768 1.214h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.935 9.935 0 0 0-7.072-2.937zm5.878 15.845a8.257 8.257 0 0 1-4.879 1.535h-.003a8.276 8.276 0 0 1-4.217-1.155l-.303-.18-3.15.827.84-3.07-.198-.315a8.234 8.234 0 0 1-1.264-4.398c0-4.564 3.713-8.277 8.28-8.277a8.226 8.226 0 0 1 5.856 2.428 8.222 8.222 0 0 1 2.42 5.857c0 4.564-3.713 8.276-8.28 8.276z"/></svg>
</a>

</body>
</html>
