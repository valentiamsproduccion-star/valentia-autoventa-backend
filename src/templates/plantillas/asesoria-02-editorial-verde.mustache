<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#12312A">
<title>{{nombre_negocio}} — Asesoría fiscal, laboral y contable</title>
<meta name="description" content="{{hero_subtitle}}">
{{#favicon_url}}<link rel="icon" href="{{favicon_url}}">{{/favicon_url}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   PLANTILLA · SERVICIOS PROFESIONALES · Asesoría
   Diseño 2: Editorial verde
   ═══════════════════════════════════════ */
:root{
  --accent:#12312A; --accent-mid:#0C231D; --accent-dim:#CFE3D6;
  --ink:#12312A; --ink-soft:#4F6A62; --cream:#F6F3EC; --white-pure:#FFFFFF; --line:#DDD6C6;
  --serif:'Fraunces',serif; --sans:'Work Sans',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{font-family:var(--sans);background:var(--cream);color:var(--ink);line-height:1.65}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:500;letter-spacing:-.01em;color:var(--ink)}
.wrap{max-width:1080px;margin:0 auto;padding:0 28px}
header{padding:28px 0}
.nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:var(--serif);font-size:22px;font-style:italic;display:flex;align-items:center;gap:9px}
.logo img{height:30px;width:auto;display:block}
nav ul{list-style:none;display:flex;gap:30px;font-size:14px;color:var(--ink-soft)}
nav ul a{color:inherit;text-decoration:none}
nav ul a:hover{color:var(--ink)}
.btn{display:inline-block;padding:12px 24px;font-size:13.5px;font-weight:600;text-decoration:none;letter-spacing:.02em;text-transform:uppercase;border:none;cursor:pointer;text-align:center}
.btn-primary{background:var(--accent);color:#fff;border-radius:2px}
.btn-primary:hover{background:var(--accent-mid)}
.btn-outline{border:1px solid var(--accent);color:var(--accent);border-radius:2px;background:transparent}
.btn-outline:hover{background:var(--accent);color:#fff}
@media(max-width:760px){nav ul{display:none}}

.hero{padding:30px 0 0}
.hero-photo{height:420px;border-radius:2px;background:linear-gradient(160deg,rgba(18,49,42,.78),rgba(18,49,42,.32)),repeating-linear-gradient(115deg,#274F44 0 2px,#1B3A32 2px 40px);position:relative;display:flex;align-items:flex-end;overflow:hidden}
.hero-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}
.hero-photo-inner{padding:44px;color:#F6F3EC;position:relative;z-index:1}
.hero-photo .eyebrow{font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;opacity:.85;margin-bottom:10px}
.hero-photo h1{font-size:48px;color:#F6F3EC;max-width:640px;line-height:1.1}
@media(max-width:640px){.hero-photo h1{font-size:32px}.hero-photo{height:320px}}

.hero-below{display:grid;grid-template-columns:1fr 1fr;gap:60px;padding:52px 0 80px;align-items:start}
@media(max-width:860px){.hero-below{grid-template-columns:1fr}}
.hero-below p{color:var(--ink-soft);font-size:16px;margin-bottom:24px}

section.blk{padding:70px 0;border-top:1px solid var(--line)}
.alt-bg{background:var(--white-pure)}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:44px;gap:30px;flex-wrap:wrap}
.section-head.centered{display:block;text-align:center;max-width:600px;margin:0 auto 44px}
.eyebrow-c{font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:10px;display:block}
.section-head h2{font-size:32px}
.section-head p{color:var(--ink-soft);font-size:15px;max-width:320px}
.section-head.centered p{max-width:none}

.areas-list{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line)}
@media(max-width:760px){.areas-list{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.areas-list{grid-template-columns:1fr}}
.area{padding:30px 26px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.area .n{font-family:var(--serif);font-style:italic;font-size:14px;color:var(--ink-soft);margin-bottom:10px}
.area h3{font-size:20px;margin-bottom:10px}
.area p{font-size:14.5px;color:var(--ink-soft)}

.team{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid var(--line)}
@media(max-width:760px){.team{grid-template-columns:1fr 1fr}}
.member{padding:24px 18px;border-right:1px solid var(--line)}
.member .ph{width:100%;aspect-ratio:1;background:var(--accent-dim);border-radius:2px;margin-bottom:14px;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-style:italic;font-size:26px;color:var(--ink)}
.member .name{font-weight:600;font-size:14.5px}
.member .rol{color:var(--ink-soft);font-size:13px;margin-top:2px}
.member .cred{color:var(--ink-soft);font-size:11.5px;margin-top:6px;opacity:.8}

.steps{display:flex;flex-direction:column;border-top:1px solid var(--line)}
.step{display:grid;grid-template-columns:80px 1fr;gap:20px;padding:26px 0;border-bottom:1px solid var(--line);align-items:baseline}
.step .num{font-family:var(--serif);font-style:italic;font-size:24px;color:var(--ink-soft)}
.step h4{font-size:18px;margin-bottom:6px;display:inline;font-family:var(--serif);font-weight:500}
.step p{color:var(--ink-soft);font-size:14.5px;margin-top:6px}

.consulta-form-wrap{margin-top:40px;border-top:1px solid var(--line);padding-top:40px}
.form-card{background:var(--white-pure);border:1px solid var(--line);padding:2rem;max-width:520px}
.form-card label{font-weight:500;color:var(--ink);font-size:13px;text-transform:uppercase;letter-spacing:.03em;display:block;margin-bottom:7px}
.field{margin-bottom:16px}
.field input,.field select,.field textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:2px;font-size:14.5px;font-family:var(--sans);outline:none;background:var(--cream);color:var(--ink)}
.field textarea{resize:vertical;min-height:80px}
.form-note{font-size:11.5px;color:var(--ink-soft);margin-top:12px;line-height:1.6}

.testis{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line)}
@media(max-width:760px){.testis{grid-template-columns:1fr}}
.testi{padding:26px;border-right:1px solid var(--line)}
.testi p{font-family:var(--serif);font-size:18px;font-style:italic;color:var(--ink)}
.testi .who{margin-top:14px;font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:.02em}
.testi .who span{display:block;font-weight:400;color:var(--ink-soft);font-size:12px;margin-top:2px;text-transform:none}

.faq-item{padding:24px 0;border-bottom:1px solid var(--line)}
.faq-item summary{font-family:var(--serif);font-size:19px;margin-bottom:8px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:'+';font-size:22px;color:var(--ink-soft);flex:none}
.faq-item[open] summary::after{content:'−'}
.faq-item p{color:var(--ink-soft);font-size:14.5px;max-width:640px;margin-top:10px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.6rem;align-items:start;margin-top:1rem}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}
.contact-list{display:flex;flex-direction:column;gap:1.1rem}
.citem{display:flex;gap:16px;align-items:flex-start;border-bottom:1px solid var(--line);padding-bottom:1.1rem}
.citem .ic{font-family:var(--serif);font-size:20px;color:var(--ink-soft);flex:none}
.citem h4{font-family:var(--serif);font-size:16px;font-weight:600}
.citem p{font-size:14px;color:var(--ink-soft)}
.map-embed{border:1px solid var(--line);aspect-ratio:4/3}
.map-embed iframe{width:100%;height:100%;border:0}

.cta-final{background:var(--ink);color:#F6F3EC;padding:70px 0;text-align:center}
.cta-final h2{color:#F6F3EC;font-size:34px;margin-bottom:14px}
.cta-final p{color:#C8D6CF;margin-bottom:28px}
.cta-final .btn-primary{background:#F6F3EC;color:var(--ink)}

footer{padding:30px 0;color:var(--ink-soft);font-size:13px}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.foot-links{display:flex;gap:22px;flex-wrap:wrap}
.foot-links a:hover{color:var(--ink)}
.legal-note{max-width:760px;margin:16px auto 0;text-align:center;font-size:11.5px;color:#8B9A93;line-height:1.6}

.wa-float{position:fixed;right:20px;bottom:20px;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.25);z-index:60}
.wa-float svg{width:28px;height:28px}
@media(max-width:600px){.wa-float{bottom:78px}}
.cta-bar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:59;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px 16px;gap:10px}
.cta-bar .btn{flex:1;padding:.8rem 1rem;font-size:12px;color:var(--ink);border:1px solid var(--line)}
.cta-bar .btn-primary{color:#fff;border-color:var(--accent);background:var(--accent)}
@media(max-width:600px){.cta-bar{display:flex}}
.tpl-badge{position:fixed;left:16px;bottom:16px;background:var(--ink);color:#F6F3EC;font-size:11px;font-weight:600;letter-spacing:.04em;padding:8px 14px;opacity:.9;z-index:61;font-family:var(--sans)}
@media(max-width:600px){.tpl-badge{bottom:78px}}
</style>
</head>
<body>

{{#preview}}<div class="tpl-badge">VISTA PREVIA · {{nombre_negocio}}</div>{{/preview}}

<header>
  <div class="wrap nav">
    <div class="logo">{{#logo_url}}<img src="{{logo_url}}" alt="{{nombre_negocio}}">{{/logo_url}}{{^logo_url}}{{nombre_negocio}}{{/logo_url}}</div>
    <nav><ul>
      <li><a href="areas.html">Áreas</a></li>
      <li><a href="equipo.html">Equipo</a></li>
      <li><a href="#consulta">Consulta</a></li>
      {{#hay_faqs}}<li><a href="#faq">FAQ</a></li>{{/hay_faqs}}
    </ul></nav>
    <a class="btn btn-outline" href="#consulta">Pedir consulta</a>
  </div>
</header>

<section class="hero"><div class="wrap">
  <div class="hero-photo">
    {{#foto_hero_url}}<img src="{{foto_hero_url}}" alt="{{nombre_negocio}}">{{/foto_hero_url}}
    <div class="hero-photo-inner">
      <div class="eyebrow">{{eyebrow_hero}}</div>
      <h1>{{hero_title}}</h1>
    </div>
  </div>
  <div class="hero-below">
    <div>
      <p>{{hero_subtitle}}</p>
      <a class="btn btn-primary" href="#consulta">Primera consulta gratuita</a>
    </div>
    <div><p>{{lead_areas}}</p></div>
  </div>
</div></section>

<section class="blk" id="areas"><div class="wrap">
  <div class="section-head"><div><span class="eyebrow-c">Áreas de práctica</span><h2>{{h2_areas}}</h2></div></div>
  <div class="areas-list">{{#areas}}<div class="area"><div class="n">Área {{n}}</div><h3>{{titulo}}</h3><p>{{descripcion}}</p></div>{{/areas}}</div>
</div></section>

<section class="blk" id="equipo"><div class="wrap">
  <div class="section-head"><div><span class="eyebrow-c">Equipo</span><h2>Quién lleva tu cuenta</h2></div><p>Un mismo interlocutor de principio a fin, no un departamento anónimo.</p></div>
  <div class="team">{{#equipo}}<div class="member">{{#foto_url}}<img class="ph" src="{{foto_url}}" alt="{{nombre}}">{{/foto_url}}{{^foto_url}}<div class="ph">{{inicial_negocio}}</div>{{/foto_url}}<div class="name">{{nombre}}</div><div class="rol">{{rol}}</div><p class="cred">{{credencial}}</p></div>{{/equipo}}</div>
</div></section>

<section class="blk" id="consulta"><div class="wrap">
  <div class="section-head"><div><span class="eyebrow-c">Primera consulta</span><h2>{{h2_consulta}}</h2></div><p>{{lead_consulta}}</p></div>
  <div class="steps">{{#consulta_points}}<div class="step"><div class="num">{{n}}</div><div><h4>{{titulo}}</h4><p>{{descripcion}}</p></div></div>{{/consulta_points}}</div>
  <div class="consulta-form-wrap">
    <div class="form-card">
      <div class="field"><label>Área que te interesa</label><select name="area">{{#areas}}<option>{{titulo}}</option>{{/areas}}<option>No lo sé</option></select></div>
      <div class="field"><label>Nombre</label><input type="text" placeholder="Tu nombre"></div>
      <div class="field"><label>Teléfono o email</label><input type="text" placeholder="Cómo te contactamos"></div>
      <div class="field"><label>Cuéntanos brevemente tu caso</label><textarea placeholder="Escribe aquí..."></textarea></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-primary" style="width:100%;display:block;text-align:center">Pedir primera consulta</a>
      <p class="form-note">Al enviar este formulario aceptas nuestra política de privacidad. Tus datos se tratan conforme al RGPD y no se ceden a terceros.</p>
    </div>
  </div>
</div></section>

{{#hay_testimonios}}
<section class="blk"><div class="wrap">
  <div class="section-head centered"><span class="eyebrow-c">Opiniones</span><h2>Lo que dicen nuestros clientes</h2></div>
  <div class="testis">{{#testimonios}}<div class="testi"><p>&quot;{{cita}}&quot;</p><div class="who">{{nombre}}<span>{{contexto}}</span></div></div>{{/testimonios}}</div>
</div></section>
{{/hay_testimonios}}

{{#hay_faqs}}
<section class="blk" id="faq"><div class="wrap" style="max-width:760px">
  <div class="section-head"><div><span class="eyebrow-c">Preguntas frecuentes</span><h2>Antes de que preguntes</h2></div></div>
  {{#faqs}}<details class="faq-item"><summary>{{pregunta}}</summary><p>{{respuesta}}</p></details>{{/faqs}}
</div></section>
{{/hay_faqs}}

<section class="blk" id="contacto"><div class="wrap">
  <div class="section-head"><div><span class="eyebrow-c">Contacto</span><h2>Visítanos o escríbenos</h2></div></div>
  <div class="contact-grid">
    <div class="contact-list">
      <div class="citem"><div class="ic">📍</div><div><h4>Ciudad</h4><p>{{ciudad}}</p></div></div>
      <div class="citem"><div class="ic">☎</div><div><h4>Teléfono</h4><p>{{telefono}}</p></div></div>
      <div class="citem"><div class="ic">✉</div><div><h4>Email</h4><p>{{email}}</p></div></div>
      <a href="https://wa.me/{{telefono_wa}}" class="btn btn-outline" style="margin-top:6px;width:fit-content">Escribir por WhatsApp</a>
    </div>
    <div class="map-embed"><iframe src="https://www.google.com/maps?q={{ciudad_url}},Spain&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section class="cta-final">
  <div class="wrap">
    <h2>¿Hablamos de tu caso?</h2>
    <p>Cuéntanos tu situación y te decimos, sin compromiso, cómo podemos ayudarte.</p>
    <a class="btn btn-primary" href="https://wa.me/{{telefono_wa}}">Pedir primera consulta</a>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>{{nombre_negocio}} — Asesoría fiscal, laboral y contable</div>
      <div class="foot-links"><a href="aviso-legal.html">Aviso legal</a><a href="privacidad.html">Política de privacidad</a><a href="cookies.html">Cookies</a></div>
    </div>
    <p class="legal-note">© {{anio}} {{nombre_negocio}}. Todos los derechos reservados. Web creada con Valentia Web.</p>
  </div>
</footer>

<div class="cta-bar"><a href="tel:{{telefono}}" class="btn">Llamar</a><a href="#consulta" class="btn btn-primary">Consulta</a></div>

<a href="https://wa.me/{{telefono_wa}}" class="wa-float" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.485 1.34 5.003l-1.42 5.183 5.309-1.394a9.96 9.96 0 0 0 4.768 1.214h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.935 9.935 0 0 0-7.072-2.937zm5.878 15.845a8.257 8.257 0 0 1-4.879 1.535h-.003a8.276 8.276 0 0 1-4.217-1.155l-.303-.18-3.15.827.84-3.07-.198-.315a8.234 8.234 0 0 1-1.264-4.398c0-4.564 3.713-8.277 8.28-8.277a8.226 8.226 0 0 1 5.856 2.428 8.222 8.222 0 0 1 2.42 5.857c0 4.564-3.713 8.276-8.28 8.276z"/></svg>
</a>

</body>
</html>
